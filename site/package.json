{
  "name": "phonometry-docs",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "private": true,
  "scripts": {
    "build": "astro build",
    "check:guides": "node scripts/check-guides-index.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:icons": "node scripts/icon-sheet.mjs --check",
    "check:math": "node scripts/check-math-render.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:search": "node scripts/check-search-designation.mjs",
    "check:sidebar": "node scripts/with-preview.mjs -- node scripts/check-sidebar.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:types": "astro check",
    "check:visual": "node scripts/with-preview.mjs -- sh -c 'node scripts/check-contrast.mjs && node scripts/check-home-headings.mjs && node scripts/check-lang-suggest.mjs && node scripts/check-page-chips.mjs'",
    "dev": "astro dev",
    "html-validate": "html-validate 'dist/**/*.html'",
    "icons:sheet": "node scripts/icon-sheet.mjs",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "pa11y": "node scripts/with-preview.mjs -- ./node_modules/.bin/pa11y-ci",
    "postbuild": "node scripts/add-sitemap-lastmod.mjs && node scripts/fix-redirect-stubs.mjs && node scripts/optimize-images.mjs && node scripts/emit-page-markdown.mjs",
    "prebuild": "node scripts/stage-media.mjs && node scripts/copy-llms.mjs",
    "preview": "astro preview",
    "redirects": "node scripts/generate-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "starlight-image-zoom": "^0.16.0",
    "starlight-links-validator": "^0.26.0",
    "starlight-sidebar-topics": "^0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "html-validate": "^11.16.0",
    "lighthouse": "^13.5.0",
    "pa11y-ci": "^4.1.1",
    "puppeteer": "25.11.0",
    "typescript": "^6.0.3"
  }
}
