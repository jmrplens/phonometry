---
/**
 * Custom Starlight <Hero> override: the default hero, with the mark supplied
 * for its image slot and the wordmark supplied for the title.
 *
 * Placed here rather than in the landing page's frontmatter because the assets
 * are generated: frontmatter would need the artwork pasted into it, and it
 * would have to be pasted again into the Spanish page. Filling the slots the
 * theme already has also means both are laid out by the theme, the mark in the
 * empty right column of the two-column hero on a wide screen and above the
 * title on a phone, instead of by a rule of ours that would have to track it.
 *
 * The title is the brand wordmark as outlines (scripts/generate_brand.py), the
 * same type the header lockup carries, so the name renders in the brand face
 * with no web font fetched and nothing to reflow once the page has painted.
 * Outlines say nothing to a screen reader, so the H1 keeps the name as
 * visually hidden text and the artwork is hidden from the accessibility tree
 * (see src/lib/brand.ts). The mark stays decoration: the H1 beside it is the
 * name, so that SVG carries no accessible name of its own either.
 */
import Default from '@astrojs/starlight/components/Hero.astro';
import { brandSvg } from '../lib/brand';

const { data } = Astro.locals.starlightRoute.entry;
if (data.hero && !data.hero.image) {
	data.hero.image = {
		html: `<span class="ph-brand ph-brand-mark">${brandSvg('mark')}</span>`,
	};
}
if (data.hero && !data.hero.title) {
	data.hero.title =
		`<span class="sr-only">${data.title}</span>` +
		`<span class="ph-brand ph-brand-word">${brandSvg('wordmark')}</span>`;
}
---

<Default />
