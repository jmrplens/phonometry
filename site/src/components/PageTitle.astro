---
/**
 * Default Starlight page title plus the page header chips run.
 *
 * The override originally existed only to give PageChips.astro a mount point
 * directly under the H1, inside the page header band and above the content
 * divider. Everything the chips run shows comes from the page's own
 * `references` frontmatter; see PageChips.astro and src/lib/reference-chips.ts.
 *
 * A byline used to sit here too, naming the maintainer and the two dates. The
 * footer credit already carries the name with rel="author", the page's JSON-LD
 * carries author, datePublished and dateModified whatever the body shows, and
 * the dates now sit together in the last-updated line at the end of the page
 * (LastUpdated.astro), which is where a reader looks for them. What the byline
 * added was the maintainer's name between the reader and the first sentence.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageChips from './PageChips.astro';
import PhIcon from './PhIcon.astro';
import { topics } from '../data/topics.mjs';

interface RouteData {
  entry?: { id?: string };
}
const route = (Astro.locals as { starlightRoute?: RouteData }).starlightRoute;
const id = route?.entry?.id ?? '';
const slug = id.replace(/^es\/?/, '');

// A topic's own overview page. It gets the drawing the sidebar gives that
// topic, beside the heading: the row a reader clicked and the page they landed
// on then carry the same mark. The heading itself is still Starlight's, so it
// keeps its own type scale and colour; the wrapper only lays the two out.
const topicId = topics.find((topic) => topic.link === `/${slug}/`)?.id;
---

{
  topicId ? (
    <div class="ph-title-row">
      <PhIcon name={topicId} class="ph-title-icon" />
      <Default>
        <slot />
      </Default>
    </div>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}
<PageChips />

<style>
  /* The heading's own top margin sat inside the row and pushed the h1 half of
     it below the icon. It belongs to the row now, so the two centre on each
     other, and the drawing is a fraction of the heading rather than a fixed
     size, so it keeps its proportion when the type scale drops on a phone. */
  .ph-title-row {
    align-items: center;
    display: flex;
    gap: 0.5em;
    margin-top: 1rem;
  }

  .ph-title-row :global(h1) {
    margin-top: 0;
  }

  .ph-title-icon {
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
    width: calc(var(--sl-text-h1) * 0.82);
    height: calc(var(--sl-text-h1) * 0.82);
  }

</style>
