---
/**
 * The glossary, rendered from src/data/glossary.mjs.
 *
 * The page used to be twelve five-column markdown tables. A table is the right
 * shape for numbers and the wrong one for a sentence: measured on a phone, the
 * definition column rendered 135 px wide while the one-word guide link took
 * 256, and the row needed 775 px of horizontal scroll inside a 358 px screen.
 * The definition is the content here, so each term is a block that gives the
 * sentence the whole width, sets the notation and the unit above it, and puts
 * the standard and the guide underneath as metadata.
 *
 * Everything comes from one array: the cards, the anchors, and the
 * `DefinedTermSet` structured data this page has always published, which used
 * to be a second hand-written copy of the same 120 entries in the frontmatter
 * of each language.
 *
 * The link to a guide takes its text from that guide's own title, read from
 * the content collection at build time, so a renamed page cannot leave a stale
 * label behind: the old tables carried the title by hand and had gone stale in
 * Spanish. A slug that resolves to no page is a build error rather than a
 * dangling link, which is what the four-way copy could never notice.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import katex from 'katex';
import { glossary } from '../data/glossary.mjs';
import { basePath } from '../data/site.mjs';
import { glossaryTermSet } from '../lib/glossary-structured-data.mjs';
import { GREEK_LETTERS, plainText } from '../lib/maths-text.mjs';

interface Props {
	/** Locale of the page the glossary is rendered on. */
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

// The base path lives in one place, which is where astro.config.mjs and the
// audit scripts read it from; a second copy here would be a second thing to
// remember on a move.
const BASE = basePath;
/** The locale prefix this page's URLs carry, after the base. */
const LOCALE = lang === 'es' ? '/es' : '';

/** A field that is either shared by both languages or given per language. */
const localized = (value: string | Record<string, string> | undefined) =>
	value === undefined ? undefined : typeof value === 'string' ? value : value[lang];

// Guide titles, by slug, in this locale. Starlight ids carry the locale prefix
// on the Spanish side and nothing on the English one.
const docs: CollectionEntry<'docs'>[] = await getCollection('docs');
const titleOf = new Map(
	docs.map((entry) => [entry.id.replace(/^es\//, ''), entry] as const)
		.filter(([, entry]) => (lang === 'es') === entry.id.startsWith('es/'))
		.map(([slug, entry]) => [slug, entry.data.title] as const),
);

/**
 * Inline maths in a field of the glossary, as HTML. A field is written the way
 * the page reads it, `$L_{Aeq}$, SEL`, so the text between the delimiters is
 * text and only the delimited runs are typeset. Every field the card shows
 * goes through it: printed as typed, "(unit of $x$)²/Hz" kept its dollar signs.
 */
function notation(source: string): string {
	return source
		.split(/(\$[^$]+\$)/g)
		.map((run) =>
			run.startsWith('$') && run.endsWith('$')
				? katex.renderToString(run.slice(1, -1), { throwOnError: false })
				: escape(run),
		)
		.join('');
}

const escape = (text: string) =>
	text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const terms = glossary.flatMap((group) =>
	group.terms.map((term) => {
		const guide = term.guide;
		const title = guide ? titleOf.get(guide) : undefined;
		if (guide && !title) {
			throw new Error(
				`glossary: term "${term.id}" points at ${guide}, which is not a page in ${lang}`,
			);
		}
		return {
			...term,
			group,
			label: term.symbol ?? localized(term.name) ?? term.id,
			unitText: localized(term.unit),
			standardText: localized(term.standard),
			clauseText: localized(term.clause),
			qualifierText: localized(term.qualifier),
			definitionText: localized(term.definition) as string,
			href: guide ? `${BASE}${LOCALE}/${guide}/` : undefined,
			guideTitle: title,
		};
	}),
);

/**
 * The bucket a symbol files under: its first Latin letter, its own character if
 * it is Greek, a digit bucket for the rest. One letter with four meanings ends
 * up as one row with the four side by side, which is the case the domain
 * grouping below cannot serve.
 */
function indexKey(label: string): string {
	for (const character of plainText(label)) {
		if (GREEK_LETTERS.has(character)) return character;
		if (/[A-Za-z]/.test(character)) return character.toUpperCase();
	}
	return '#';
}

// The structured data comes from the same array, built where the check's own
// tests can build it too (src/lib/glossary-structured-data.mjs).
const jsonld = glossaryTermSet(lang, (slug) => titleOf.get(slug));

// The symbol index: Latin letters first, then the Greek ones, each row holding
// every entry whose notation starts with that character.
const index = new Map<string, { id: string; scan: string; qualifier?: string }[]>();
for (const term of terms) {
	const key = indexKey(term.label);
	const row = index.get(key) ?? [];
	row.push({
		id: term.id,
		scan: plainText(term.label),
		qualifier: term.qualifierText ? plainText(term.qualifierText) : undefined,
	});
	index.set(key, row);
}
const indexRows = [...index.entries()].sort(([a], [b]) => {
	const greek = (key: string) => (GREEK_LETTERS.has(key) ? 1 : 0);
	return greek(a) - greek(b) || a.localeCompare(b, 'en');
});

const t =
	lang === 'es'
		? {
				definedIn: 'Definida en',
				see: 'Guía',
				index: 'Índice de símbolos: todos los significados de una letra, juntos',
			}
		: {
				definedIn: 'Defined in',
				see: 'Guide',
				index: 'Symbol index: every meaning of a letter, side by side',
			};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />

<details class="symbol-index">
	<summary>{t.index}</summary>
	<div>
		{indexRows.map(([letter, entries]) => (
			<p class="symbol-index-row">
				{/* The row and the card footers below are flex boxes, which draw
				    no space between their items; the written ones are for a
				    reader with no stylesheet, who would otherwise read
				    "C50C80" and a clause number run into a guide's title. */}
				<b>{letter}</b>{' '}
				{entries.map((entry) => (
					<>
						<a href={`#${entry.id}`}>
							{entry.scan}
							{entry.qualifier && <span class="qualifier"> ({entry.qualifier})</span>}
						</a>{' '}
					</>
				))}
			</p>
		))}
	</div>
</details>

{
	glossary.map((group) => (
		<section class="glossary-group">
			<h2 id={group.id}>{group.label[lang]}</h2>
			<div class="glossary-terms">
				{terms
					.filter((term) => term.group === group)
					.map((term) => (
						<article class="glossary-term" id={term.id}>
							<header>
								<h3 class="notation">
									<Fragment set:html={notation(term.label)} />
									{term.qualifierText && (
										<span class="qualifier" set:html={`(${notation(term.qualifierText)})`} />
									)}
								</h3>
								{term.unitText && <span class="unit" set:html={notation(term.unitText)} />}
							</header>
							<p class="definition" set:html={notation(term.definitionText)} />
							<footer>
								<span class="standard">
									{t.definedIn}: <Fragment set:html={notation(term.standardText ?? '')} />
									{term.clauseText && <>, <Fragment set:html={notation(term.clauseText)} /></>}
								</span>{' '}
								{term.href && (
									<a class="guide" href={term.href}>
										{term.guideTitle}
									</a>
								)}
							</footer>
						</article>
					))}
			</div>
		</section>
	))
}

<style>
	/* The symbol index is closed by default: it is the answer for a reader who
	   has a letter and no domain, and dead weight for everyone else. */
	.symbol-index {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.5rem 0.85rem;
		margin-block: 1rem 1.5rem;
	}

	.symbol-index summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}

	/* One row per letter, wrapping: the four meanings of R end up side by side,
	   which is the whole point of the index. */
	.symbol-index-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.75rem;
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
	}

	.symbol-index-row b {
		flex: 0 0 1.6rem;
		color: var(--sl-color-text-accent);
	}

	.symbol-index-row .qualifier {
		color: var(--sl-color-gray-3);
	}

	/* One column on a phone, two once there is room for two readable measures.
	   The cards are the content of this page, so they use the article width
	   rather than a fixed one. */
	.glossary-terms {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: 1fr;
		margin-block: 1rem 2rem;
	}

	@media (min-width: 60rem) {
		.glossary-terms {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.glossary-term {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.85rem 1rem 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* The anchor target gets a moment of colour, so a reader who followed a
	   link to one term can see which one answered. */
	.glossary-term:target {
		border-color: var(--sl-color-text-accent);
		box-shadow: 0 0 0 1px var(--sl-color-text-accent);
	}

	.glossary-term header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}

	/* The notation leads the card. It is a heading for the outline and for a
	   screen reader, not for the type scale, so it takes the body size. */
	.glossary-term .notation {
		font-size: var(--sl-text-base);
		font-weight: 600;
		margin: 0;
		border: 0;
		padding: 0;
	}

	.glossary-term .qualifier {
		font-weight: 400;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-inline-start: 0.35rem;
	}

	/* The unit is a property of the quantity, not part of its name: it sits
	   apart, in the corner the eye reaches after the notation. */
	.glossary-term .unit {
		flex-shrink: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-text-accent);
		background: var(--sl-color-gray-6);
		border-radius: 999px;
		padding: 0.1rem 0.55rem;
		white-space: nowrap;
	}

	.glossary-term .definition {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}

	.glossary-term footer {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		border-top: 1px solid var(--sl-color-gray-6);
		padding-top: 0.5rem;
		font-size: var(--sl-text-xs);
	}

	.glossary-term .standard {
		color: var(--sl-color-gray-3);
	}

	.glossary-term .guide {
		flex-shrink: 0;
		font-weight: 600;
	}
</style>
