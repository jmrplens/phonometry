			unquantified: 'the page prints a word here',
		},
	},
	es: {
		search: 'Filtrar por material',
		searchGas: 'Filtrar por gas',
		searchFacing: 'Filtrar por velo',
		searchFloor: 'Filtrar por suelo',
		searchDuct: 'Filtrar por conducto',
		searchCondition: 'Filtrar por condición',
		searchPlaceholder: 'acero, espuma, vidrio',
		groundPlaceholder: 'hierba, nieve, asfalto',
		gasPlaceholder: 'metano, argón, vapor',
		liquidPlaceholder: 'agua, etanol, mercurio',
		treatmentPlaceholder: 'muescado, alfombra',
		carpetPlaceholder: 'nylon, lana, rizo',
		resilientModulusPlaceholder: 'lana de roca, corcho',
		solidNonlinearityPlaceholder: 'FCC, NaCl, iónico',
		absorptionPlaceholder: 'moqueta, yeso, terciopelo',
		partitionPlaceholder: 'ladrillo, puerta, vidrio',
		scatteringPlaceholder: 'pirámide, semiesfera, acebo',
		woodPlaceholder: 'pícea, arce',
		plateauPlaceholder: 'acero, vidrio, ladrillo',
		porousPlaceholder: 'lana de vidrio, espuma, fieltro',
		areaPlaceholder: 'público, músico, aire',
		geometryPlaceholder: 'h/L = 20, w = 10 cm',
		fluidPlaceholder: 'agua, mercurio, vapor',
		diffusionPlaceholder: 'semielipse, triángulo, QRD',
		dampingPlaceholder: 'DYAD, ISD, Soundcoat',
		facingPlaceholder: 'FM 125, 1584, 40',
		resilientPlaceholder: 'poliestireno, lana, espuma',
		floorPlaceholder: 'hormigón, moqueta, viguetas',
		ductPlaceholder: '610, circular, entrada',
		conditionPlaceholder: '20 °C, 50-70',
		empty: 'Ninguna fila coincide con ese filtro.',
		material: 'Material',
		surface: 'Superficie',
		gas: 'Gas',
		finish: 'Acabado',
		partition: 'Construcción',
		facing: 'Velo resistivo',
		floor: 'Suelo o tratamiento',
		duct: 'Conducto',
		condition: 'Condición',
		state: 'Estado',
		substance: 'Sustancia',
		treatment: 'Tratamiento',
		construction: 'Construcción',
		structure: 'Material o estructura',
		conditions: 'Condiciones',
		mounting: 'Montaje',
		per: 'Por',
		solver: 'Calculado con',
		direction: 'Dirección',
		shape: 'Forma',
		gauge: 'Calibre de chapa',
		weave: 'Tejido',
		bonding: 'Enlace',
		fixedBy: 'Qué lo fija',
		source: 'Fuente',
		regionLabel: 'Valores publicados, con desplazamiento lateral',
		legend: 'La cursiva es un valor calculado por esta biblioteca; el subrayado punteado es una celda que no es un número a secas, y lo que es se lee en la propia celda; el asterisco es una nota que la página hace sobre la fila. Haz clic en una marca para leerla, o pon el foco en la tabla y pulsa Intro para recorrerlas con las flechas.',
		kinds: {
			printed: 'tal como lo imprime la página',
			fixed: 'lo que fija el modelo o la norma que lleva al lado',
			derived: 'calculado por esta biblioteca',
			converted: 'convertido desde la cifra de la página',
			carried: 'la página da este valor en otra de sus filas',
			approximate: 'la página lo imprime con una tilde',
			estimated: 'la página lo marca como estimación, no como medida',
			range: 'la página imprime un intervalo',
			bound: 'la página imprime una cota, no un valor',
			reported: 'la página enumera varias lecturas',
			unquantified: 'la página imprime una palabra aquí',
		},
	},
}[lang];

/* The three things a catalogue is asked for by name: what its filter is
   called, what it suggests you type into it and what its first column holds.
   A lookup and not a chain of conditionals, because with seventeen catalogues
   the chain was seven deep before this and the entry for a new one has to be
   one line in an obvious place rather than a nesting level. Anything not named
   here is a table of materials, which is what most of them are. */

/** What the filter is called, which is not a material in every catalogue. */
const searchLabels: Partial<Record<typeof section, string>> = {
	gases: copy.searchGas,
	flowResistance: copy.searchFacing,
	impactInsulation: copy.searchFloor,
	ductTransmissionLoss: copy.searchDuct,
	airAttenuation: copy.searchCondition,
};
const searchLabel = searchLabels[section] ?? copy.search;

/** What to search for, which is not a material in the ground catalogue. */
const placeholders: Partial<Record<typeof section, string>> = {
	ground: copy.groundPlaceholder,
	gases: copy.gasPlaceholder,
	absorption: copy.absorptionPlaceholder,
	absorptionAreas: copy.areaPlaceholder,
	orthotropicWood: copy.woodPlaceholder,
	plateau: copy.plateauPlaceholder,
	porous: copy.porousPlaceholder,
	predictedScattering: copy.geometryPlaceholder,
	fluids: copy.fluidPlaceholder,
	transmissionLoss: copy.partitionPlaceholder,
	scattering: copy.scatteringPlaceholder,
	diffusion: copy.diffusionPlaceholder,
	damping: copy.dampingPlaceholder,
	flowResistance: copy.facingPlaceholder,
	resilientLayers: copy.resilientPlaceholder,
	/* The impact insulation is the second catalogue after Arau's absorption
	   whose rows are printed in Spanish, and this one is printed in Spanish in
	   both languages of this page: the handbook it comes from is a Spanish
	   translation, the row is a paragraph describing a floor, and a reader
	   typing "concrete" into an English page finds nothing. */
	impactInsulation: copy.floorPlaceholder,
	ductTransmissionLoss: copy.ductPlaceholder,
	airAttenuation: copy.conditionPlaceholder,
	nonlinearity: copy.liquidPlaceholder,
	dampingTreatments: copy.treatmentPlaceholder,
	carpets: copy.carpetPlaceholder,
	resilientModuli: copy.resilientModulusPlaceholder,
	solidNonlinearity: copy.solidNonlinearityPlaceholder,
};
const placeholder = placeholders[section] ?? copy.searchPlaceholder;

/** What the first column holds, which is not a material in every catalogue. */
const rowHeadings: Partial<Record<typeof section, string>> = {
	fluids: copy.state,
	nonlinearity: copy.substance,
	solidNonlinearity: copy.structure,
	dampingTreatments: copy.treatment,
	carpets: copy.construction,
	ground: copy.surface,
	gases: copy.gas,
	absorption: copy.finish,
	absorptionAreas: copy.finish,
	transmissionLoss: copy.partition,
	scattering: copy.surface,
	diffusion: copy.surface,
	predictedScattering: copy.surface,
	flowResistance: copy.facing,
	impactInsulation: copy.floor,
	ductTransmissionLoss: copy.duct,
	airAttenuation: copy.condition,
};
const rowHeading = rowHeadings[section] ?? copy.material;

/** A column's heading in the language this page is published in. */
const heading = (column: { heading: string; headingEs?: string }) =>
	(lang === 'es' && column.headingEs) || column.heading;

/** The distinct published tables of a catalogue, for its filter. */
const tablesOf = (rows: { table: string }[]) => [...new Set(rows.map((row) => row.table))].sort();

/** A row's words on this page. The Spanish page prints the Spanish the
    generator attached to the row, where there is one; the English page, and a
    row whose book already prints Spanish, print what the row carries. */
const say = (row: CatalogueRow, field: CatalogueTextField | 'gauge') =>
	(lang === 'es' && field !== 'gauge' && row.es?.[field]) || row[field] || '';

/** A cell's text and note on this page: a range reads "0,4 a 0,8" in Spanish. */
const cellText = (cell: CatalogueCell) => (lang === 'es' && cell.textEs) || cell.text;
const cellNote = (cell: CatalogueCell) => (lang === 'es' && cell.noteEs) || cell.note;

/** Lower case and without accents, so "hormigon" finds "hormigón" and
    "aluminium" still finds the row on the Spanish page. The finder folds what
    the reader types, and the words a row shows, the same way. */
const folded = (text: string) =>
	text
		.normalize('NFD')
		.replace(/\p{M}/gu, '')
		.toLowerCase();

const data = catalogues[section];
const tables = tablesOf(data.rows);

/* The columns that hold a word rather than a quantity, each appearing when a
   row of this catalogue fills it, which is the rule the quantity columns
   follow: no catalogue pays a column for what another one carries. Every one
   of them is the thing that tells two otherwise identical rows apart.

   The mount, because the same board on the floor and over a 400 mm airspace
   is two rows of one name with different numbers. What an area is an area of,
   because an audience is priced per person and the air per cubic metre and
   both are printed in square metres. Which solver produced a row, because a
   coefficient a boundary element model computed and one a reverberation room
   measured are the same number and not the same evidence. Which way the sound
   crossed a duct wall, what shape that duct is and what gauge its sheet was,
   because the six duct tables print one size in six rows. And how a glass
   cloth is woven, which is the column its own page prints where the wire mesh
   table prints a wire count.

   `wrap` is what the value asks for rather than a style: a word or two sits
   on its line, and only the phrase columns need the block that caps their
   width. The order is the order they are declared in, and the solver stays
   last because it is the widest. */
const textColumns = (
	[
		{ field: 'mounting', label: copy.mounting, wrap: false },
		{ field: 'per', label: copy.per, wrap: true },
		{ field: 'direction', label: copy.direction, wrap: false },
		{ field: 'shape', label: copy.shape, wrap: false },
		{ field: 'gauge', label: copy.gauge, wrap: false },
		{ field: 'weave', label: copy.weave, wrap: false },
		{ field: 'bonding', label: copy.bonding, wrap: false },
		/* The fluids carry a model too, and it is what fixes the state rather
		   than a solver that computed a row, so it is the last column of that
		   table and not one of these. */
		{ field: 'model', label: copy.solver, wrap: true, notOn: 'fluids' },
	] as {
		field: 'mounting' | 'per' | 'direction' | 'shape' | 'gauge' | 'weave' | 'bonding' | 'model';
		label: string;
		wrap: boolean;
		notOn?: string;
	}[]
).filter(
	(column) =>
		column.notOn !== section &&
		data.rows.some((row) => row[column.field]),
);

/** What the filter matches a row by and the row does not show on this page.

    The filter reads the words a row shows: its name, with the heading above it
    and the variant under it, its note, every word column and its source,
    together with the key of the table it came off. What a reader might type
    and cannot see is the rest, and it is little. On the English page it is
    nothing, or a source a fluid state does not print. On the Spanish page it is
    the book's own English, so that "aluminium" still finds the row that reads
    "aluminio", and the parts of the generator's Spanish the table does not
    print. Each is written once, folded the way the filter folds, and only
    when the row does not already show it. */
const alsoOf = (row: CatalogueRow) => {
	const shown = new Set(
		[
			say(row, 'name'),
			say(row, 'variant'),
			say(row, 'group'),
			say(row, 'note'),
			...textColumns.map((column) => say(row, column.field)),
			say(row, section === 'fluids' ? 'model' : 'source'),
		]
			.filter(Boolean)
			.map(folded),
	);
	const matched = [
		row.name,
		row.variant,
		row.group,
		row.source,
		row.model,
		...textColumns.map((column) => row[column.field]),
		...(lang === 'es' ? Object.values(row.es ?? {}) : []),
	];
	return [...new Set(matched.filter((text): text is string => !!text).map(folded))]
		.filter((text) => !shown.has(text))
		.join(' ');
};

/** The highest column the stacked view labels: see the rules at the end of
    the stylesheet below, which go up to `nth-child(24)`. */
const LABELLED_COLUMNS = 24;

/** Every column after the row's own heading, as the stacked view labels it:
    the word columns, the conditions of a fluid, the quantities and the
    source, in the order the row prints them. */
const columnLabels = [
	...textColumns.map((column) => ({ label: column.label, unit: '' })),
	...(section === 'fluids' ? [{ label: copy.conditions, unit: '' }] : []),
	...data.columns.map((column) => ({ label: heading(column), unit: column.unit })),
	{ label: section === 'fluids' ? copy.fixedBy : copy.source, unit: '' },
];
if (columnLabels.length + 1 > LABELLED_COLUMNS) {
	throw new Error(
		`[Catalogues] the ${section} catalogue has ${columnLabels.length + 1} columns and the ` +
			`stylesheet labels the first ${LABELLED_COLUMNS} in the stacked view: add the rules ` +
			'for the others at the end of the stylesheet and raise LABELLED_COLUMNS.',
	);
}

/** A CSS string literal holding `text`. */
const cssString = (text: string) =>
	`"${text.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\a ')}"`;

/* The heading and the unit of each column, once per table, as the custom
   properties the stacked view reads: `--l3` labels the third cell of a row and
   `--u3` follows its number. The row heading is the first cell, so the first
   labelled one is the second. Written per cell, as `data-label` and
   `data-unit`, this was a fifth of the page. */
const columnStyle = columnLabels
	.flatMap(({ label, unit }, index) => [
		`--l${index + 2}:${cssString(label)}`,
		...(unit ? [`--u${index + 2}:${cssString(`\u00a0${unit}`)}`] : []),
	])
	.join(';');

/** The title a marked cell carries: the page's own note when it made one,
    otherwise what the mark means, and for a converted cell the figure and the
    unit the page printed after it. A number the page simply printed has
    nothing to explain and carries none. */
const cellTitle = (cell: CatalogueCell) =>
	cellNote(cell) ||
	(cell.kind === 'printed' || cell.kind === 'absent'
		? undefined
		: cell.printed
			? `${copy.kinds[cell.kind]}: ${cell.printed}`
			: copy.kinds[cell.kind]);
---

{/* The filters live in CatalogueFinder.astro, which sits above the rows of
    the first catalogue on the page, and reach in here through these
    attributes: which catalogue this is, what its filter should be called and
    suggest, how many rows it holds and which published tables it draws on.
    The id is the same word in both languages; a link from a guide goes to the
    catalogue's page, and this id is what the finder lands on when it opens
    the page at its table. */}
<section
	class="catalogue not-content"
	id={`catalogue-${section}`}
	data-catalogue={section}
	data-row-count={data.rows.length}
	data-search-label={searchLabel}
	data-placeholder={placeholder}
	data-tables={JSON.stringify(tables)}
>
	<p class="legend">{copy.legend}</p>

	{/* Focusable because it scrolls sideways and holds nothing focusable of
	    its own: Chrome and Firefox focus such a region by themselves, WebKit
	    does not, and a reader who cannot reach it cannot read past the third
	    column. */}
	<div class="table-scroll" tabindex="0" role="region" aria-label={copy.regionLabel}>
		<table style={columnStyle}>
			<thead>
				<tr>
					<th scope="col">{rowHeading}</th>
					{textColumns.map((column) => <th scope="col">{column.label}</th>)}
					{section === 'fluids' && <th scope="col">{copy.conditions}</th>}
					{
						data.columns.map((column) => (
							<th scope="col" class="numeric">
								{heading(column)}
								{column.unit && <span class="unit">{column.unit}</span>}
							</th>
						))
					}
					<th scope="col">{section === 'fluids' ? copy.fixedBy : copy.source}</th>
				</tr>
			</thead>
			<tbody>
				{
					data.rows.map((row) => (
						/* The row is told apart by where it sits and by what it
						   holds: the first cell is its name, a word column is
						   the one cell with a class, the last cell is its
						   source and everything between is a quantity. */
						<tr data-table={row.table} data-also={alsoOf(row) || undefined}>
							<th scope="row" title={say(row, 'note') || undefined}>
								<span>
									{row.group && <span class="group">{say(row, 'group')}</span>}
									{say(row, 'name')}
									{row.variant && <span class="variant">{say(row, 'variant')}</span>}
								</span>
								{row.note && <span class="note">{say(row, 'note')}</span>}
							</th>
							{textColumns.map((column) => (
								<td class={column.field}>
									{say(row, column.field) &&
										(column.wrap ? <span>{say(row, column.field)}</span> : say(row, column.field))}
								</td>
							))}
							{section === 'fluids' && (
								<td class="conditions">
									<span>
										{row.temperature} °C, {row.pressure} Pa
									</span>
								</td>
							)}
							{row.cells.map((cell) =>
								/* An empty cell is empty, so the stacked view leaves it
								   out by `:empty`. One with a title is a cell this
								   library will not fill although the arithmetic would
								   reach it, and the title says why; it stays blank
								   because the page is blank there. A number the page
								   simply printed is bare text, and only the cells
								   that are not a plain number carry a mark and a title:
								   "as the page prints it" on every other cell would
								   bury them. */
								cell.text ? (
									<td>
										{cell.kind === 'printed' && !cellNote(cell) ? (
											cellText(cell)
										) : (
											<span class={`cell-${cell.kind}`} title={cellTitle(cell)}>
												{cellText(cell)}
											</span>
										)}
									</td>
								) : (
									<td title={cellNote(cell) || undefined} />
								),
							)}
							<td>
								{say(row, section === 'fluids' ? 'model' : 'source') && (
									<span>{say(row, section === 'fluids' ? 'model' : 'source')}</span>
								)}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	{/* The zero-result message is a live region, and a live region has to be
	    in the document from the start: a screen reader announces a change to
	    one it was already watching, and one that appears by losing `hidden` it
	    may not have been watching at all. So the paragraph is always here and
	    always empty, and the filter writes the sentence into it. The message
	    travels on the element because the script that fills it is shared and
	    this component is the only thing that knows which language it is in. */}
	<p class="empty" data-empty-message role="status" data-message={copy.empty}></p>
</section>

<script>
	/* The explanations that hang off a cell.
	   Every mark in these tables promises a sentence: what a dotted underline
	   means, what a page actually printed where a number is missing, what note
	   the book made about a row. Until now that sentence was a `title`, which
	   is a promise a phone cannot keep at all and a desktop keeps only after
	   the browser's own delay, on hover, in a tooltip nobody can copy from.

	   So the sentence now opens on click, at once, and on hover after a pause
	   of its own. The `title` stays on the element while no pointer is near
	   it, because that is what a screen reader reads and what a reader with
	   JavaScript off still gets; it is lifted off only while this tooltip is
	   the thing showing, or the browser would print its own on top a moment
	   later. */
	(() => {
		const tables = document.querySelectorAll('[data-catalogue]');
		if (tables.length === 0) return;

		const tip = document.createElement('div');
		tip.className = 'catalogue-tip';
		tip.id = 'catalogue-tip';
		tip.setAttribute('role', 'tooltip');
		tip.hidden = true;
		document.body.append(tip);

		let current: HTMLElement | null = null;
		let pinned = false;
		let timer = 0;

		/** Put the `title` back on whatever we last took it from. */
		const restore = (element: HTMLElement | null) => {
			if (element && element.dataset.tip !== undefined) {
				element.setAttribute('title', element.dataset.tip);
				delete element.dataset.tip;
			}
		};

		const hide = () => {
			clearTimeout(timer);
			tip.hidden = true;
			current?.removeAttribute('aria-describedby');
			restore(current);
			current = null;
			pinned = false;
		};

		const place = (element: HTMLElement) => {
			const box = element.getBoundingClientRect();
			tip.hidden = false;
			const own = tip.getBoundingClientRect();
			const margin = 8;
			let left = box.left + box.width / 2 - own.width / 2;
			left = Math.max(margin, Math.min(left, window.innerWidth - own.width - margin));
			/* Above the cell when there is room, below it when there is not:
			   the row at the top of a phone screen is exactly the one whose
			   explanation would otherwise be drawn off the top of it. */
			const above = box.top - own.height - margin;
			tip.style.left = `${Math.round(left)}px`;
			tip.style.top = `${Math.round(above > margin ? above : box.bottom + margin)}px`;
		};

		const open = (element: HTMLElement, { pin }: { pin: boolean }) => {
			/* A click can land inside the hover delay. Without this the pending
			   timer fires a moment later with `pin: false`, and the pointer
			   leaving then closes what the click had pinned open. */
			clearTimeout(timer);
			if (current && current !== element) restore(current);
			const text = element.getAttribute('title') ?? element.dataset.tip;
			if (!text) return;
			if (element.hasAttribute('title')) {
				element.dataset.tip = text;
				element.removeAttribute('title');
			}
			current?.removeAttribute('aria-describedby');
			current = element;
			pinned = pin;
			tip.textContent = text;
			element.setAttribute('aria-describedby', tip.id);
			place(element);
		};

		const target = (event: Event): HTMLElement | null => {
			const element =
				event.target instanceof Element ? event.target.closest<HTMLElement>('[title]') : null;
			if (element && element.closest('[data-catalogue]')) return element;
			/* Already open and its `title` is parked in `dataset.tip`, so the
			   selector above no longer matches it. */
			const parked =
				event.target instanceof Element ? event.target.closest<HTMLElement>('[data-tip]') : null;
			return parked && parked.closest('[data-catalogue]') ? parked : null;
		};

		for (const table of tables) {
			table.addEventListener('pointerover', (event) => {
				if (pinned) return;
				const element = target(event);
				if (!element || element === current) return;
				clearTimeout(timer);
				timer = window.setTimeout(() => open(element, { pin: false }), 400);
			});
			table.addEventListener('pointerout', (event) => {
				if (pinned) return;
				const element = target(event);
				if (element && element === current) hide();
				else clearTimeout(timer);
			});
			table.addEventListener('click', (event) => {
				const element = target(event);
				if (!element) return;
				if (pinned && element === current) {
					hide();
					return;
				}
				open(element, { pin: true });
			});
		}

		/* The keyboard path to the same sentences.
		   Making every marked cell focusable was the obvious idea and it is the
		   wrong one: the solids table alone carries 766 of them, which is 766
		   tab stops between this table and whatever follows it on the page. So
		   the scroll box keeps the single tab stop it already had, and holds a
		   cursor of its own: Enter starts it at the first mark, the arrow keys
		   walk the marks in reading order, and Escape gives the box back to the
		   browser, where the arrows scroll it sideways as they always did. The
		   cursor skips the rows the filter is hiding, because a reader stepping
		   through six carpets should not be walked through the four hundred
		   rows they filtered out. */
		const marksOf = (region: Element): HTMLElement[] =>
			[...region.querySelectorAll<HTMLElement>('[title], [data-tip]')].filter((element) => {
				const row = element.closest('tr');
				return !row || !row.hidden;
			});

		let cursor: HTMLElement | null = null;
		let cursorRegion: HTMLElement | null = null;

		const leaveCursor = () => {
			cursor?.classList.remove('cell-cursor');
			cursor = null;
			cursorRegion = null;
		};

		const moveCursor = (region: HTMLElement, step: number) => {
			const marks = marksOf(region);
			if (marks.length === 0) return;
			const from = cursor ? marks.indexOf(cursor) : -1;
			const next = marks[Math.min(Math.max(from + step, 0), marks.length - 1)] ?? marks[0];
			cursor?.classList.remove('cell-cursor');
			cursor = next;
			cursorRegion = region;
			cursor.classList.add('cell-cursor');
			cursor.scrollIntoView({ block: 'nearest', inline: 'nearest' });
			open(cursor, { pin: true });
		};

		/** Which way a printed arrow key steps the cursor, in reading order. */
		const ARROW_STEP: Record<string, number> = {
			ArrowRight: 1,
			ArrowDown: 1,
			ArrowLeft: -1,
			ArrowUp: -1,
		};

		for (const region of document.querySelectorAll<HTMLElement>('[data-catalogue] .table-scroll')) {
			region.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					moveCursor(region, cursorRegion === region ? 0 : 1);
					return;
				}
				if (cursorRegion !== region) return;
				const step = ARROW_STEP[event.key];
				if (step === undefined) return;
				event.preventDefault();
				moveCursor(region, step);
			});
			region.addEventListener('focusout', (event) => {
				if (cursorRegion !== region) return;
				if (event.relatedTarget instanceof Node && region.contains(event.relatedTarget)) return;
				leaveCursor();
				hide();
			});
		}

		document.addEventListener('click', (event) => {
			if (!pinned) return;
			/* The finder's controls now sit inside the catalogue they filter, and
			   reaching for them is leaving the table, so they close it too. */
			const inside =
				event.target instanceof Element &&
				event.target.closest('[data-catalogue]') !== null &&
				event.target.closest('[data-finder]') === null;
			if (!inside) hide();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			leaveCursor();
			hide();
		});
		/* Scrolling must not close it: the table scrolls sideways inside its own
		   box, a phone scrolls the page under your thumb, and the browser
		   scrolls the cell into view when you click it, which closed the
		   tooltip the click had just opened. The tooltip is positioned against
		   the viewport, so it follows the cell instead, and gives up only when
		   the cell itself has left the screen. `capture` is what makes the
		   sideways scroll of the table reach this at all: a scroll event on an
		   element does not bubble. */
		const follow = () => {
			if (!current || tip.hidden) return;
			const box = current.getBoundingClientRect();
			const gone =
				box.bottom < 0 ||
				box.top > window.innerHeight ||
				box.right < 0 ||
				box.left > window.innerWidth;
			if (gone) hide();
			else place(current);
		};
		window.addEventListener('scroll', follow, { passive: true, capture: true });
		window.addEventListener('resize', hide);
	})();
</script>

<style is:global>
	/* The tooltip is appended to the body so that nothing in the table can clip
	   it: the scroll box the table lives in has `overflow-x: auto`, and a
	   tooltip drawn inside it would be cut off exactly at the edges where the
	   reader most needs it. Its class is named for the page it belongs to. */
	.catalogue-tip {
		position: fixed;
		z-index: 100;
		max-width: min(32rem, calc(100vw - 1rem));
		padding: 0.5rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		box-shadow: 0 2px 10px rgb(0 0 0 / 35%);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		/* It follows the pointer's target, never the pointer, so it must not
		   become a target itself: hovering it would fire the leave that hides
		   it and the two would fight. */
		pointer-events: none;
	}

	/* Everything below is global and starts at `.catalogue`, the section this
	   component renders, rather than scoped: a scoped rule makes Astro write
	   its class on every element it could match, which was one class on each
	   of the twenty-five thousand cells, and nothing else on these pages uses
	   these selectors. */
	.catalogue {
		margin-block: 2.5rem;
	}

	/* `not-content` on the section is Starlight's own opt-out from the
	   styles it gives markdown tables, and this table needs it. One of them
	   reads
	   `table tr > th:first-child:nth-last-child(n+4) { white-space: nowrap }`,
	   which is meant for a header row of four or more columns and catches a
	   row header just as well, because a `<th scope="row">` is also the first
	   child of its row. Measured: it beat every rule this component could
	   write, at three classes and three elements of specificity, and it is
	   why the name of a material rendered on one line and the sticky column
	   printed itself over the densities on a narrow screen. Opting out means
	   the table below is styled here and nowhere else, which is the point.

	   The rule after it is the measured one Conformance.astro also carries:
	   without an explicit min-width the container reports
	   scrollWidth == clientWidth in Chromium and clips the last columns with
	   no way to reach them. */
	.catalogue .table-scroll {
		overflow-x: auto;
		margin-block: 0.5rem 1rem;
	}

	.catalogue .table-scroll:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.catalogue .table-scroll table {
		min-width: min-content;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}

	.catalogue th,
	.catalogue td {
		padding: 0.35rem 0.6rem;
		border-block-end: 1px solid var(--sl-color-gray-5);
		text-align: start;
		vertical-align: top;
	}

	.catalogue thead th {
		white-space: nowrap;
		font-weight: 600;
	}

	.catalogue .unit {
		display: block;
		font-weight: 400;
		font-size: 0.85em;
		color: var(--sl-color-gray-3);
	}

	/* The name stays put while the numbers scroll: a transverse speed with no
	   material beside it is not worth reading. */
	/* Both text columns need a floor as well as a ceiling. The table is laid
	   out at `min-width: min-content`, which resolves a column of prose to the
	   width of its longest word: the citation column collapsed to about eight
	   characters, wrapped "Hopkins (2007) Table A2, PDF pages 635-636 (no
	   printed folio; between folios 607 and 610)" over fifteen lines, and made
	   every row of the solids three hundred pixels tall while the numbers in
	   it occupied one line. */
	.catalogue tbody th {
		position: sticky;
		inset-inline-start: 0;
		background: var(--sl-color-black);
		font-weight: 500;
		min-width: 16ch;
	}

	/* A table cell ignores `max-width`: the automatic layout algorithm decides
	   the column widths and treats it as a suggestion, so the ceiling has to
	   sit on a block inside the cell. Without this the name column took its
	   max-content width on a narrow screen, where the table is far wider than
	   the viewport anyway, and the sticky first column then printed
	   "Dense aggregate blocks (solid) connected with mortar" straight over the
	   density beside it. `min-width` on the cell is honoured and stays there,
	   because a floor is what stops a column of prose collapsing to its
	   longest word. The block is the first span of the name, the one span of
	   a phrase column and of the conditions, and the span of the source, which
	   is the last cell of every row. */
	.catalogue tbody th > span:first-child,
	.catalogue .per > span,
	.catalogue .model > span,
	.catalogue .conditions > span,
	.catalogue tbody td:last-child > span {
		display: block;
		max-width: 22ch;
	}

	/* A row of the impact insulation is not named, it is described: the page
	   prints a paragraph per construction, up to eleven hundred characters of
	   it, because about a dozen of them are "the same as 18 except that ...".
	   At the width every other catalogue is happy with, the whole catalogue
	   was thirty-eight thousand pixels tall, one word per line, and the two
	   numbers beside each description sat alone at the top of it.

	   Both halves are needed, and the comments above say why: the floor is on
	   the cell, because that is the one the automatic table layout honours,
	   and the ceiling is on the block inside it, because a cell treats
	   `max-width` as a suggestion. */
	.catalogue[data-catalogue='impactInsulation'] tbody th {
		min-width: 44ch;
	}

	.catalogue[data-catalogue='impactInsulation'] tbody th > span:first-child {
		max-width: 52ch;
	}

	/* Wider than the name column, because a citation is four fields long and
	   every row carries one: at 24ch "Hopkins (2007) Table A2, PDF pages
	   635-636 (no printed folio)" wrapped to four lines and set the height of
	   a row whose numbers are one line, which is what made the table look
	   full of holes. */
	.catalogue tbody td:last-child > span {
		max-width: 38ch;
	}

	/* The conditions are one short line, "20 °C, 101 325 Pa", and giving them
	   the width of a citation pushed the column that says which document
	   fixes each state off the side of the table: five of the seven rows are
	   an air, and that column is the only thing that tells them apart. */
	.catalogue .conditions > span {
		max-width: 20ch;
	}

	.catalogue .variant {
		display: block;
		font-weight: 400;
		font-size: 0.9em;
		color: var(--sl-color-gray-3);
	}

	/* The heading the book prints above a block of rows. It goes above the
	   name rather than beside it because it is what the name is short for:
	   "h = w = 10 cm, L = 2h" is a batten only under "Periodic 1D battens". */
	.catalogue .group {
		display: block;
		font-weight: 400;
		font-size: 0.82em;
		color: var(--sl-color-gray-3);
	}

	/* A quantity is every cell between the word columns, which are the cells
	   with a class, and the source, which is the last: no cell says it is a
	   number, its place in the row does. */
	.catalogue thead th.numeric,
	.catalogue tbody td:not([class]):not(:last-child) {
		text-align: end;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.catalogue tbody td:last-child {
		color: var(--sl-color-gray-3);
		min-width: 34ch;
		white-space: normal;
	}

	/* The short word columns belong beside the name and not among the numbers:
	   "A" right-aligned under a heading called Mount reads as a quantity, and
	   so does a sheet gauge of 24. None of them is longer than "flat oval", so
	   none of them wraps and none needs the block that caps a phrase. */
	.catalogue .mounting,
	.catalogue .direction,
	.catalogue .shape,
	.catalogue .gauge,
	.catalogue .weave {
		white-space: nowrap;
		color: var(--sl-color-gray-2);
	}

	/* Wide enough for "cubic metre of air at 50% RH" on two lines and no
	   wider: the quantity columns are what the reader came for. At 16ch that
	   phrase broke into five. */
	.catalogue .per {
		color: var(--sl-color-gray-2);
		min-width: 14ch;
	}

	.catalogue .per > span {
		max-width: 22ch;
	}

	/* Wide enough that "three-dimensional boundary element prediction"
	   wraps onto three lines. At sixteen characters it broke into six, one
	   word per line, and every row of the table grew to match. */
	.catalogue .model {
		min-width: 21ch;
	}

	.catalogue .model > span {
		max-width: 26ch;
	}

	.catalogue .conditions {
		color: var(--sl-color-gray-3);
		min-width: 18ch;
		white-space: normal;
	}

	/* What a page says about a row beyond its numbers is a sentence, and a
	   sentence in a table cell is what made a hundred and twelve rows of the
	   solids three hundred pixels tall: the longest of them is 257 characters,
	   and at the width this column can afford that is ten lines that push
	   every number in the row away from its neighbours. It reads on the name
	   instead, which is the cell that identifies the row, with a mark to say
	   it is there. */
	.catalogue tbody th:has(> .note)::after {
		content: '*';
		color: var(--sl-color-gray-3);
		padding-inline-start: 0.15em;
	}

	.catalogue tbody th[title] {
		cursor: help;
	}

	/* The note reads on hover in the table and on the card in the stacked
	   view, because a phone has no hover and the mark alone would promise
	   something the reader cannot reach. */
	.catalogue .note {
		display: none;
	}

	/* One mark per kind of cell, so the difference between a number a book
	   printed and a number this library worked out survives the rendering. */
	.catalogue td > [class^='cell-'] {
		border-block-end: 1px dotted transparent;
		cursor: help;
	}

	.catalogue .cell-printed {
		cursor: auto;
	}

	/* A state the tree carries beside a model or a standard rather than off a
	   printed table: the number is as firm as a printed one and it did not
	   come from a page, so it is marked like the other cells that need a word
	   of explanation and unlike the ones a book printed. */
	.catalogue .cell-fixed {
		border-block-end-color: var(--sl-color-gray-3);
	}

	.catalogue .cell-derived {
		font-style: italic;
		border-block-end-color: var(--sl-color-gray-3);
	}

	.catalogue .cell-approximate::before {
		content: '~';
		color: var(--sl-color-gray-3);
	}

	.catalogue .cell-range,
	.catalogue .cell-bound,
	.catalogue .cell-reported,
	.catalogue .cell-estimated,
	.catalogue .cell-converted,
	.catalogue .cell-carried {
		border-block-end-color: var(--sl-color-gray-3);
	}

	.catalogue .cell-unquantified {
		font-style: italic;
		color: var(--sl-color-gray-3);
		border-block-end-color: var(--sl-color-gray-3);
	}

	/* Where the keyboard cursor is. It is not `:focus-visible`, because the
	   element under the cursor never takes focus: the scroll box keeps it, so
	   that the table stays one tab stop, and the ring has to be drawn by hand. */
	.catalogue .cell-cursor {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.catalogue .empty {
		color: var(--sl-color-gray-3);
	}

	/* Nothing to say, and an empty paragraph still takes a line. */
	.catalogue .empty:empty {
		display: none;
	}

	/* What the marks in the table mean, beside the table. The prose above the
	   table says it too, but a reader who arrived at a row from a search is
	   not reading the prose, and `title` is not a text alternative anybody can
	   rely on. */
	.catalogue .legend {
		margin-block: 0 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	/* Two hundred and nineteen rows of numbers, and nothing in a cell to hold
	   the eye to its line. The stripe is mixed rather than picked so that one
	   declaration serves both themes: `--sl-color-black` is the page behind
	   the table in each, and a quarter of the mid grey is the same small step
	   away from it whether that page is white or black. The sticky first
	   column paints its own background, so it takes the stripe too or the
	   numbers would scroll under a name of a different colour. */
	.catalogue tbody tr:nth-child(even) > * {
		background: color-mix(in srgb, var(--sl-color-gray-5) 25%, var(--sl-color-black));
	}

	/* A phone gets the rows stacked instead of a table fifteen columns wide.
	   Sideways scrolling through a table that is four screens across is not
	   reading: you lose the material before you reach the modulus, and the
	   sticky column that keeps the name in view takes a third of the screen
	   to do it. Each row becomes a card titled by its material, holding only
	   the quantities that row actually has, and the heading of each column
	   travels in a custom property of the table, `--l<n>` for the n-th cell
	   of a row and `--u<n>` for its unit, because there is no header row left
	   to look up to. */
	@media (max-width: 55rem) {
		.catalogue .table-scroll {
			overflow-x: visible;
		}

		.catalogue .table-scroll table {
			display: block;
			min-width: 0;
			font-size: var(--sl-text-sm);
		}

		.catalogue thead {
			display: none;
		}

		.catalogue tbody,
		.catalogue tr {
			display: block;
		}

		/* `display: block` above outranks the user agent's `[hidden]` rule, which
		   is what the filter sets, so without this a search that matched three
		   rows still showed all two hundred and fifty-eight of them on a phone. */
		.catalogue tbody tr[hidden] {
			display: none;
		}

		.catalogue tbody tr {
			margin-block-end: 0.75rem;
			padding: 0.6rem 0.75rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
		}

		/* The stripe moves to the card, because a card is the row now. */
		.catalogue tbody tr:nth-child(even) > * {
			background: none;
		}

		.catalogue tbody tr:nth-child(even) {
			background: color-mix(in srgb, var(--sl-color-gray-5) 25%, var(--sl-color-black));
		}

		.catalogue th,
		.catalogue td {
			padding: 0.15rem 0;
			border-block-end: none;
		}

		.catalogue tbody th {
			position: static;
			display: block;
			min-width: 0;
			margin-block-end: 0.4rem;
			padding-block-end: 0.35rem;
			border-block-end: 1px solid var(--sl-color-gray-5);
			background: none;
			font-size: var(--sl-text-base);
			font-weight: 600;
