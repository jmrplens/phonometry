# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# The Python build-artifact rule above also matches the site's source
# helpers directory, which is real source and must stay tracked.
!site/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.env
.venv
env/
venv/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.iml
.DS_Store

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Project specific generated files
# CI-generated PR-comment artifacts (conformance report + comment body)
conformance_report.md
pr_comment_body.md
*.wav
# ISO 532-1 normative validation signals are tracked explicitly
# (see tests/data/iso532_1/README.md for provenance and ISO attribution)
!tests/data/iso532_1/**/*.wav
!tests/data/iso532_1/*.wav
tests/*.png
snyk.sarif
issues_final*.json
node_modules/

# Local work plans (brainstorming specs, implementation plans, source library)
plan/
docs/superpowers/

# Full copies of the heavy oracle sets that cannot be redistributed (the
# stipa.info certified STIPA bench, the EBU loudness test set, the NORAH2
# public release). Tests prefer them when present and otherwise fall back to
# the committed derived data and extracts under tests/data/, which is what CI
# runs. See tests/data/README.md and tests/oracle_data.py.
tests/data-local/

# Astro docs site
site/node_modules/
site/dist/
site/.astro/

# Published copies of the root-level llms artifacts (llms.txt and
# llms-full.txt). The prebuild step copies them in from the repo root, which
# is where the committed originals live. The per-area shards are not ignored:
# they are committed in site/public/llms/, which this pattern does not reach.
site/public/llms*.txt
stub/dist/
stub/src/*.egg-info/
.playwright-mcp/

# Documentation media staged into the site by scripts/stage-media.mjs from
# .github/images and .github/reports, which are the committed originals.
site/public/media/
site/lighthouse-results/

# Fiches a snippet writes where it was run. The guides show `.report("x.pdf")`
# with a bare filename, which is the honest way to document it, so running one
# to check a number drops the PDF in whatever directory you were standing in.
# Seventeen of them reached the repository root that way. The originals live in
# .github/reports and are committed from there, so nothing at the root is ever
# wanted.
/*.pdf

# The freshness check takes this lock while it rewrites the manifest.
scripts/animation_fingerprints.lock
