// The phonometry.dev preview: one Worker that serves the staged build as
// Static Assets and runs code only for the visitor beacon and the files
// agents read (site/worker/README.md says why).
//
// Requests for static assets are free and unlimited on Workers Free and run
// no script, so pages, _astro, media and every other file cannot be stopped
// by the plan's 100,000 daily requests. `assets.run_worker_first` lists the
// only paths that run src/index.mjs (generated by lib/agent-paths.mjs, held
// equal by test/wrangler.test.mjs); with it a Free account over its quota
// answers 429 on those paths, which is why the quota guard (guard/) rolls
// the Worker to wrangler.assets-only.jsonc at 95 % of the day. That file is
// this one with the code taken out; the test derives one from the other.
// Any other binding fails the test until it is added on purpose.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "phonometry-docs",
	// The Phonometry account. An account id is not a secret, and wrangler reads
	// it before CLOUDFLARE_ACCOUNT_ID, so a shell that points that variable at
	// another account (or a token that cannot list accounts) still deploys,
	// rolls back and lists versions here and nowhere else.
	"account_id": "4dbfb3b955a0c856bfe066f2a6061dd5",
	"main": "src/index.mjs",
	"compatibility_date": "2026-11-17",
	"assets": {
		// Written by stage.mjs: the build under its base path, plus _headers,
		// _redirects and .assetsignore.
		"directory": "./stage",
		// env.ASSETS: src/index.mjs answers an agent file through it, so
		// _redirects, _headers and the 404 page apply as for any asset.
		"binding": "ASSETS",
		// A folder's index.html answers at the path with a trailing slash, the
		// form every link of the site uses; the other form gets a redirect.
		"html_handling": "auto-trailing-slash",
		// No asset: 404 with the nearest 404.html, the site's own page.
		"not_found_handling": "404-page",
		// The beacon and the agent files: nothing else runs code. Generated by
		// lib/agent-paths.mjs for the base path /phonometry.
		"run_worker_first": [
			"/_v",
			"/phonometry/index.md",
			"/phonometry/*/index.md",
			"/llms*.txt",
			"/phonometry/llms*.txt",
			"/robots.txt",
			"/phonometry/robots.txt",
			"/sitemap*.xml",
			"/phonometry/*.xml"
		]
	},
	// One data point per request the Worker runs for, in docs-edge's layout
	// (lib/edge-log.mjs). The dataset belongs to this account and is created
	// by the first write.
	"analytics_engine_datasets": [{ "binding": "REQS", "dataset": "phonometry_dev_requests" }],
	// At most 30 stored beacons a minute from one address (an IPv6 one by its
	// /56); above it the beacon still answers 204 and its point says
	// beacon-limited. Per Cloudflare location and approximate; it saves no
	// invocation (the zone's rate rule does that, lib/rules.mjs). The
	// namespace id is a number of this account, not a secret.
	"ratelimits": [{ "name": "PER_IP", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } }],
	// The apex is the Worker's Custom Domain: Cloudflare creates its DNS record
	// and certificate on the first deploy. www reaches the apex through a zone
	// redirect rule (lib/rules.mjs).
	"routes": [{ "pattern": "phonometry.dev", "custom_domain": true }],
	// Only phonometry.dev serves it: no workers.dev address, no preview URLs.
	// Elsewhere the zone's WAF and rate rules would not apply, and a flood
	// there would spend the account's quota unchecked.
	"workers_dev": false,
	"preview_urls": false,
	// The dataset is the log; Workers Logs stay off.
	"observability": { "enabled": false }
}
