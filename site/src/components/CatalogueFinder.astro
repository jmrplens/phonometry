---
/**
 * The one place to choose what you are looking at on the catalogues page.
 *
 * The page holds seventeen catalogues and more than fifteen hundred rows.
 * Printed one after another that is a page you scroll through rather than a
 * page you consult, and on a phone the first table is several screens below
 * the fold, so a reader who arrived wanting the density of lead met an essay
 * about how the rows are sourced and no sign that a table existed at all.
 *
 * So the three choices a reader actually makes, which catalogue, which
 * material and which published table, are made here, once, and only the
 * chosen catalogue is shown. The per-catalogue filters that used to sit above
 * each table are gone: two of the three choices were repeated eleven times
 * and the third, the one that matters most, could not be made at all.
 *
 * The panel sits where the table starts, not at the top of the page. At the
 * top, a reader who had scrolled down a table to compare two rows had to
 * scroll all the way back up to change catalogue or filter, and on a phone
 * the panel itself was a screen tall, so the button that was meant to carry
 * them past the prose was below the fold. What stays at the top is that one
 * button, and it lands on the panel; the script moves the panel above the
 * first table of whichever catalogue is shown.
 *
 * Nothing here is rendered from a list of catalogues kept in this file. The
 * options are read out of the document: every `<section data-catalogue>` the
 * page rendered, labelled by the `## heading` above it, which is prose in the
 * page and therefore already translated. Adding a catalogue to the page adds
 * it to this control and to nothing else.
 *
 * Progressive enhancement, like the table it drives: the panel stays hidden
 * until the script runs, and with JavaScript off the page is the eleven
 * catalogues one after another, exactly as it was, with every row in the
 * document for Pagefind to index.
 */
interface Props {
	/** Locale of the page it is rendered on. */
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const copy = {
	en: {
		category: 'Category',
		table: 'Published table',
		everyTable: 'Every table',
		jump: 'Go to the table',
		rows: 'rows',
		hint: 'Every catalogue on this page is behind this control. Pick one and only that one is shown.',
	},
	es: {
		category: 'Categoría',
		table: 'Tabla publicada',
		everyTable: 'Todas las tablas',
		jump: 'Ir a la tabla',
		rows: 'filas',
		hint: 'Todos los catálogos de esta página están detrás de este control. Elige uno y sólo se muestra ese.',
	},
}[lang];
---

<div class="jump not-content" data-finder-jump hidden>
	<button type="button" data-jump>{copy.jump}</button>
</div>

<div
	class="finder not-content"
	data-finder
	data-rows-word={copy.rows}
	data-every-table={copy.everyTable}
	hidden
>
	<p class="hint">{copy.hint}</p>
	<div class="controls">
		<label class="wide">
			<span>{copy.category}</span>
			<select data-category></select>
		</label>
		<label class="wide">
			<span data-search-label></span>
			<input type="search" data-search />
		</label>
		<label>
			<span>{copy.table}</span>
			<select data-table>
				<option value="">{copy.everyTable}</option>
			</select>
		</label>
		<span class="count" data-count></span>
	</div>
</div>

<script>
	/** One catalogue: a heading, the prose and tables under it, and the state
	    the controls above need once it is picked. `key`, `rowCount` and
	    `published` are filled in a second pass, right after every group is
	    found and before any of them is read. */
	interface CatalogueGroup {
		heading: Element;
		nodes: Element[];
		tables: HTMLElement[];
		key: string;
		rowCount: number;
		published: string[];
	}

	(() => {
		const finder = document.querySelector<HTMLElement>('[data-finder]');
		const sections = [...document.querySelectorAll<HTMLElement>('[data-catalogue]')];
		if (!finder || sections.length === 0) return;

		const category = finder.querySelector<HTMLSelectElement>('[data-category]');
		const search = finder.querySelector<HTMLInputElement>('[data-search]');
		const searchLabel = finder.querySelector<HTMLElement>('[data-search-label]');
		const tableSelect = finder.querySelector<HTMLSelectElement>('[data-table]');
		const count = finder.querySelector<HTMLElement>('[data-count]');
		const jumpBar = document.querySelector<HTMLElement>('[data-finder-jump]');
		const jump = jumpBar?.querySelector<HTMLButtonElement>('[data-jump]');
		if (!category || !search || !searchLabel || !tableSelect || !count || !jumpBar || !jump) return;
		/* The two words the control prints for itself. They travel on the panel
		   rather than through `define:vars`, which would force this script inline
		   and therefore to run where it is written, above every table it is
		   looking for. */
		const rowsWord = finder.dataset.rowsWord ?? '';
		const everyTable = finder.dataset.everyTable ?? '';

		/* A catalogue on this page is a heading, the prose under it and one or
		   more tables: three kinds of sibling in the same markdown flow rather
		   than one element that could be hidden on its own. So the flow is walked
		   once and cut at every `h2`, and a run that contains a table is a
		   catalogue. It has to be a run rather than one table per heading because
		   the absorption heading covers two: the coefficients, and the few rows
		   the same pages price in equivalent absorption area because they have no
		   surface to multiply. A reader who asks for absorption wants both. */
		const root = sections[0].parentElement;
		if (!root) return;
		const flow = [...root.children];
		const groups: CatalogueGroup[] = [];
		let run: CatalogueGroup | null = null;
		for (const node of flow) {
			/* Starlight does not leave a heading bare: it wraps it, with its
			   anchor link, in a `div.sl-heading-wrapper`, so the cut is made on
			   whatever element holds the `h2` rather than on the `h2` itself. */
			const h2 = node.tagName === 'H2' ? node : node.querySelector(':scope > h2');
			if (h2) {
				run = { heading: h2, nodes: [node], tables: [], key: '', rowCount: 0, published: [] };
				groups.push(run);
				continue;
			}
			if (!run) continue;
			run.nodes.push(node);
			if (node instanceof HTMLElement && node.matches('[data-catalogue]')) run.tables.push(node);
		}
		const catalogues = groups.filter((group) => group.tables.length > 0);
		if (catalogues.length === 0) return;
		for (const group of catalogues) {
			group.key = group.tables[0].dataset.catalogue ?? '';
			group.rowCount = group.tables.reduce(
				(total, table) => total + Number(table.dataset.rowCount ?? 0),
				0,
			);
			group.published = [
				...new Set(group.tables.flatMap((table) => JSON.parse(table.dataset.tables ?? '[]'))),
			].sort();
		}

		/** The heading's own words, without the anchor link Starlight adds. */
		const labelOf = (group: CatalogueGroup) => {
			// `cloneNode` is typed as returning a plain `Node` however specific the
			// element cloned was; a clone of an `Element` is always an `Element`.
			const clone = group.heading.cloneNode(true) as Element;
			for (const anchor of clone.querySelectorAll('a')) anchor.remove();
			return (clone.textContent ?? '').trim();
		};

		for (const group of catalogues) {
			const option = document.createElement('option');
			option.value = group.key;
			option.textContent = `${labelOf(group)} (${group.rowCount} ${rowsWord})`;
			category.append(option);
		}

		let active = catalogues[0];

		const rowsOf = (group: CatalogueGroup) =>
			group.tables.flatMap((table) => [...table.querySelectorAll<HTMLElement>('[data-row]')]);

		const applyFilter = () => {
			/* Folded the way Catalogues.astro folds each row's words, so a reader
			   who types "hormigon" or "argon" finds "hormigón" and "argón". */
			const needle = search.value
				.trim()
				.normalize('NFD')
				.replace(/\p{M}/gu, '')
				.toLowerCase();
			const wanted = tableSelect.value;
			let shown = 0;
			for (const row of rowsOf(active)) {
				const visible =
					(!needle || (row.dataset.text ?? '').includes(needle)) &&
					(!wanted || row.dataset.table === wanted);
				row.hidden = !visible;
				if (visible) shown += 1;
			}
			count.textContent = `${shown} ${rowsWord}`;
			/* One message per table, so the reader is told which of the two
			   absorption tables their filter emptied and which still has rows. */
			for (const table of active.tables) {
				const empty = table.querySelector<HTMLElement>('[data-empty-message]');
				const left = [...table.querySelectorAll<HTMLElement>('[data-row]')].some(
					(row) => !row.hidden,
				);
				if (empty) empty.textContent = left ? '' : (empty.dataset.message ?? '');
			}
		};

		/** Bring the panel, and with it the top of the table, into view. */
		const toPanel = () => finder.scrollIntoView({ behavior: 'smooth', block: 'start' });

		const show = (
			group: CatalogueGroup,
			{ scroll }: { scroll?: 'heading' | 'panel' } = {},
		) => {
			active = group;
			/* The panel goes where this catalogue's table starts: after its
			   heading, the prose that introduces it and the legend of the
			   marks, directly above the rows it filters. It sits inside the
			   shown catalogue, so hiding the others never hides it. */
			const first = group.tables[0];
			(first.querySelector(':scope > .table-scroll') ?? first).before(finder);
			for (const other of catalogues) {
				const hide = other !== group;
				for (const node of other.nodes) node.classList.toggle('catalogue-hidden', hide);
			}
			category.value = group.key;
			searchLabel.textContent = group.tables[0].dataset.searchLabel ?? '';
			search.placeholder = group.tables[0].dataset.placeholder ?? '';
			search.value = '';
			tableSelect.replaceChildren();
			const every = document.createElement('option');
			every.value = '';
			every.textContent = everyTable;
			tableSelect.append(every);
			for (const table of group.published) {
				const option = document.createElement('option');
				option.value = table;
				option.textContent = table;
				tableSelect.append(option);
			}
			applyFilter();
			if (scroll === 'heading') group.heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
			if (scroll === 'panel') toPanel();
		};

		/* A link can name a catalogue two ways: by the heading's own id, which is
		   what this page's table of contents uses and what every guide links to,
		   and is therefore Spanish on the Spanish page; or by the section's
		   stable id, the same word in both languages, which nothing publishes
		   but which is the obvious thing to try by hand. */
		const fromHash = () => {
			/* Decoded because the Spanish headings are `#sólidos` and
			   `#coeficientes-de-absorción`, which a browser hands back
			   percent-encoded. Anything can be typed after a `#`, though, and a
			   fragment like `%zz` makes `decodeURIComponent` throw: unguarded
			   that exception left the panel revealed and uninitialised, with all
			   eleven catalogues on the page and no options in its table filter.
			   A fragment nobody can decode names no catalogue. */
			let hash;
			try {
				hash = decodeURIComponent(location.hash.replace('#', ''));
			} catch {
				return null;
			}
			if (!hash) return null;
			return (
				catalogues.find((group) => group.tables.some((table) => table.id === hash)) ??
				catalogues.find((group) => group.heading.id === hash) ??
				null
			);
		};

		category.addEventListener('change', () => {
			const group = catalogues.find((candidate) => candidate.key === category.value);
			if (group) show(group, { scroll: 'panel' });
		});
		search.addEventListener('input', applyFilter);
		tableSelect.addEventListener('change', applyFilter);
		jump.addEventListener('click', toPanel);
		/* A link from a guide names the catalogue's heading, so it lands on
		   the heading and the prose that says what the table is. */
		window.addEventListener('hashchange', () => {
			const group = fromHash();
			if (group) show(group, { scroll: 'heading' });
		});

		finder.removeAttribute('hidden');
		jumpBar.removeAttribute('hidden');
		show(fromHash() ?? catalogues[0]);
	})();
</script>

<style is:global>
	/* The heading, the prose and the table of a catalogue nobody asked for.
	   `!important` because the rule has to beat whatever display the markdown
	   styles give an `h2` or a `p`, and losing that fight would leave eleven
	   catalogues stacked on the page with one of them also claiming to be the
	   only one shown. */
	.catalogue-hidden {
		display: none !important;
	}
</style>

<style>
	/* The button that stays at the top of the page. It is the only thing
	   there, so a phone shows it without scrolling. */
	.jump {
		margin-block: 0 1.5rem;
	}

	.jump button {
		font: inherit;
		padding: 0.45rem 1rem;
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 0.25rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		cursor: pointer;
	}

	.jump button:hover {
		background: color-mix(in srgb, var(--sl-color-text-accent) 82%, var(--sl-color-black));
	}

	/* No scroll margin of its own: Starlight's scroll padding already keeps
	   what scrolls into view clear of its header and the table of contents
	   bar, and a margin on top of it stopped the panel halfway down a phone. */
	.finder {
		margin-block: 1rem;
		padding: 1rem 1.15rem 1.15rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: color-mix(in srgb, var(--sl-color-gray-6) 45%, var(--sl-color-black));
	}

	.hint {
		margin: 0 0 0.9rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: end;
	}

	.controls label {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	/* The two controls a reader reaches for first get room to print what they
	   hold: a category option is a heading plus its row count, and at the
	   width a bare select takes "Predicted scattering coefficients (119 rows)"
	   is elided to about a third of itself. */
	.controls .wide {
		flex: 1 1 15rem;
		min-width: 0;
	}

	.controls input,
	.controls select {
		font: inherit;
		width: 100%;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
	}

	.count {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-block-end: 0.45rem;
	}

	/* On a phone the controls are one per line, and the button at the top
	   takes the full width, where a thumb finds it. */
	@media (max-width: 30rem) {
		.controls {
			gap: 0.7rem;
		}

		.controls label,
		.jump button {
			flex: 1 1 100%;
			width: 100%;
		}
	}
</style>
