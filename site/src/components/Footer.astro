---
// Custom Starlight <Footer> override: renders the default footer, then a
// human-visible maintainer block that corroborates the Person node in the
// site-wide JSON-LD @graph (GEO: entity corroboration).
//
// The block used to be one line of text links separated by middle dots, which
// on a phone became a single run of words wrapping mid-list. It is now two
// parts that wrap as units: the credit, and a row of destinations where the two
// code hosts are marks rather than words. Everything the old line linked to is
// still linked, from the same URLs.
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';

const path = Astro.url.pathname;
const lang = path.includes('/es/') || path.endsWith('/es') ? 'es' : 'en';
const text = lang === 'es' ? 'Creado y mantenido por' : 'Created and maintained by';

// The maintainer's project index. Gives a reader — and a crawler — a path from
// this project to the whole portfolio, where every #software node in the
// identity graph is listed together. Not `rel="me"`: it is a page, not an
// identity profile.
const projectsUrl = lang === 'es' ? 'https://jmrp.io/es/projects/' : 'https://jmrp.io/projects/';
const projectsText = lang === 'es' ? 'Todos los proyectos' : 'All projects';

// What changed in each release, and what has changed since the last one. The
// site is built from the main branch, so a page can describe what no release
// carries yet; the changelog's Unreleased section says what that is. The
// release workflow writes the notes of each release it publishes from the
// changelog's section of that version (scripts/release_notes.py). The releases
// up to 4.0.0rc1 came before it, and the notes of none of them hold that
// section: from 2.0.0 on they link the changelog and list the pull requests.
const releaseNotes = {
	href: 'https://github.com/jmrplens/phonometry/releases',
	text: lang === 'es' ? 'Notas de versión' : 'Release notes',
};
const changelog = {
	href: 'https://github.com/jmrplens/phonometry/blob/main/CHANGELOG.md',
	text: lang === 'es' ? 'Registro de cambios' : 'Changelog',
};

// This site's own page about the maintainer: who he is, the record that backs
// it, and how the library's numbers are made. The credit's name links his
// personal site; this link keeps a reader on the page that answers for this
// project.
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const aboutUrl = `${base}${lang === 'es' ? '/es' : ''}/start/about/`;
const aboutText = lang === 'es' ? 'Acerca del mantenedor' : 'About the maintainer';

// Icon links carry their name in `aria-label` and in `title`, since the mark
// itself says nothing to a screen reader and nothing to a reader who does not
// recognise it. The repository and the package are works, so neither takes
// `rel="me"`; the ORCID record below is an identity page of the same person as
// the Person node, which is what the attribute is for.
const marks = [
	{ href: 'https://github.com/jmrplens/phonometry', label: 'GitHub', icon: 'github' },
	{ href: 'https://pypi.org/project/phonometry/', label: 'PyPI', icon: 'seti:python' },
] as const;
---

<Default><slot /></Default>
<div class="maintainer">
	<span class="credit"
		>{text} <a href="https://jmrp.io" rel="author">José Manuel Requena Plens</a></span
	>
	<span class="links">
		{
			marks.map((mark) => (
				<a class="mark" href={mark.href} aria-label={mark.label} title={mark.label}>
					<Icon name={mark.icon} size="1.15rem" />
				</a>
			))
		}
		<a class="orcid" href="https://orcid.org/0000-0003-1250-6212" rel="me">ORCID</a>
		<a class="about" href={aboutUrl}>{aboutText}</a>
		<a class="release" href={releaseNotes.href}>{releaseNotes.text}</a>
		<a class="release" href={changelog.href}>{changelog.text}</a>
		<a class="projects" href={projectsUrl}>{projectsText}</a>
	</span>
</div>

<style>
	.maintainer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1rem;
		margin-top: 1rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	/* One flex item, so the sentence wraps as a sentence and never leaves the
	   maintainer's name stranded on a line of its own. */
	.credit {
		text-wrap: balance;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.maintainer a {
		color: var(--sl-color-text-accent);
	}
	.links a {
		display: inline-flex;
		align-items: center;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.links a:hover,
	.links a:focus-visible {
		color: var(--sl-color-text-accent);
	}
	/* A 1.15rem glyph is an 18 px pointer target, which only clears WCAG 2.2
	   SC 2.5.8 through the spacing exception, and these replaced text links
	   that were larger. The padding takes each mark past the 24 px minimum on
	   its own; the matching negative margin means nothing moves on screen and
	   the two hit areas still do not touch. */
	.links a.mark {
		padding: 0.3rem;
		margin: -0.3rem;
	}
	.orcid {
		font-family: var(--ph-mono);
		font-size: var(--sl-text-2xs);
		letter-spacing: 0.08em;
	}
	.about,
	.release,
	.projects,
	.orcid {
		text-decoration: none;
		border-bottom: 1px solid var(--ph-border-strong);
	}
</style>
