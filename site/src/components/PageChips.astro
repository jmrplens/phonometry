---
/**
 * Page header chips: one run under the H1 stating which standards govern the
 * page and which named works its methods are attributed to (see
 * TOC-REDESIGN-NOTES.md).
 *
 * Everything comes from the page's own `references` frontmatter through
 * src/lib/reference-chips.ts, so the header cannot disagree with the
 * References section at the bottom, and every chip links to its full entry
 * there. Pages without references render nothing.
 *
 * The presentation is settled: one outlined pill per source, styled in
 * src/styles/page-chips.css. Nothing here is switchable; the only reason
 * this component renders nothing is a page with no `references`.
 */
import { pageChips } from '../lib/reference-chips';

const { entry, lang } = Astro.locals.starlightRoute;
const isEs = lang.startsWith('es');
const { standards, references, hidden } = pageChips(entry.data.references, isEs);

const labels = isEs
	? { standards: 'Normas aplicables:', references: 'Referencias:', more: (n: number) => `+${n} más` }
	: { standards: 'Standards:', references: 'Key references:', more: (n: number) => `+${n} more` };
---

{
	(standards.length > 0 || references.length > 0) && (
		<p class="page-chips">
			{standards.length > 0 && (
				<span class="chip-run chip-run-standard">
					<span class="sr-only">{labels.standards} </span>
					{standards.map((chip) => (
						<a class="page-chip chip-standard" href={`#${chip.anchor}`}>
							{chip.text}
						</a>
					))}
				</span>
			)}
			{references.length > 0 && (
				<span class="chip-run chip-run-reference">
					<span class="sr-only">{labels.references} </span>
					{references.map((chip) => (
						<a class="page-chip chip-theory" href={`#${chip.anchor}`}>
							{chip.text}
						</a>
					))}
				</span>
			)}
			{hidden > 0 && (
				<a class="page-chip chip-more" href="#references">
					{labels.more(hidden)}
				</a>
			)}
		</p>
	)
}

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
</style>
