{
  "name": "phonometry-docs",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "private": true,
  "scripts": {
    "build": "astro build",
    "check:cited-standards": "node scripts/check-cited-standards.mjs",
    "check:crawl": "node scripts/check-crawl.mjs",
    "check:descriptions": "node scripts/check-descriptions.mjs",
    "check:guides": "node scripts/check-guides-index.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:icons": "node scripts/icon-sheet.mjs --check",
    "check:math": "node scripts/check-math-render.mjs",
    "check:page-size": "node scripts/check-page-size.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:render-spawns": "node scripts/check-render-spawns.mjs",
    "check:schema-vocabulary": "node scripts/check-schema-vocabulary.mjs",
    "check:search": "node scripts/check-search-designation.mjs",
    "check:sidebar": "node scripts/with-preview.mjs -- node scripts/check-sidebar.mjs",
    "check:social-card-titles": "node scripts/check-social-card-titles.mjs",
    "check:social-cards": "node scripts/check-social-cards.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:types": "astro check --minimumFailingSeverity hint",
    "check:visual": "node scripts/with-preview.mjs -- sh -c 'node scripts/check-contrast.mjs && node scripts/check-home-headings.mjs && node scripts/check-lang-suggest.mjs && node scripts/check-page-chips.mjs && node scripts/check-reference-pages.mjs'",
    "dev": "astro dev",
    "html-validate": "html-validate 'dist/**/*.html'",
    "icons:sheet": "node scripts/icon-sheet.mjs",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "pa11y": "node scripts/with-preview.mjs -- ./node_modules/.bin/pa11y-ci",
    "postbuild": "node scripts/add-sitemap-lastmod.mjs && node scripts/fix-redirect-stubs.mjs && node scripts/optimize-images.mjs && node scripts/emit-page-markdown.mjs",
    "prebuild": "node scripts/stage-media.mjs && node scripts/copy-llms.mjs",
    "preview": "astro preview",
    "redirects": "node scripts/generate-redirects.mjs",
    "redirects:cloudflare": "node scripts/cloudflare-redirects.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.4",
    "katex": "catalog:",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.17.0",
    "lighthouse": "^13.6.0",
    "pa11y-ci": "^5.0.0",
    "puppeteer": "25.16.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
