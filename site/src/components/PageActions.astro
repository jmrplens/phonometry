---
/**
 * Page actions: hand this page to something that reads text.
 *
 * Every page written as a file publishes a clean markdown copy of itself at
 * `<page>/index.md` (scripts/emit-page-markdown.mjs) and advertises it in the
 * head with `<link rel="alternate" type="text/markdown">`. That is the right
 * artifact for an agent, a reader pasting a page into a chat, or anyone who
 * wants the prose without ~90% chrome around it, and until now nothing on the
 * page said it existed: only a machine parsing the head could find it. This is
 * the visible handle on it.
 *
 * Which page has a copy, and where, is decided in src/routeData.ts from the
 * content collection rather than from the address being viewed: a route served
 * as fallback content has no file of its own, and gets the copy of the entry it
 * is actually rendering. Everything here is behind that address, so no entry in
 * this control can point at a page that was never written.
 *
 * Written here rather than installed. The two published Starlight plugins for
 * this both fail on this site: one declares `astro ^5` and drags in a second
 * markdown-emission pipeline it cannot be told to skip, and translates
 * nothing; the other emits its own copy of every page through `tidymd`,
 * unconditionally, which on a based site doubles the base path in every
 * internal link and leaves the MDX component tags in the text. Both would have
 * meant shipping a second, worse answer to "give me this page as markdown"
 * beside the one this site already gets right.
 *
 * A split button: the left half copies, the right half opens the rest. That is
 * the shape both of those plugins settled on and the one readers recognise, so
 * the common action costs one press and the others are one press away.
 *
 * The menu holds two scales of the same intent. Four entries are about this
 * page: its address, its text, and the two handoffs that hand a model the
 * address. The fifth is about the project, a BibTeX entry assembled at build
 * time in `src/data/citation.mjs` from the repository's own `CITATION.cff`, and
 * it is set below a separator so it does not read as a fifth way to get the
 * page. Neither of the two entries that copy fetches anything: both carry what
 * they copy in the markup.
 *
 * Behaviour lives in the module script at the bottom, bundled by Astro and
 * served from this origin, so the existing Content-Security-Policy is
 * unchanged: the only network call is a `fetch` of this site's own index.md,
 * which `connect-src 'self'` already allows.
 */
import { bibtex } from '../data/citation.mjs';

// The address of this page's markdown copy, or undefined where the generator
// wrote none: the two splash pages, which are a component layout rather than
// prose, and the synthesised 404. Head.astro withholds the `rel="alternate"`
// link on exactly this test, and the whole control is withheld below.
const { lang: routeLang, markdownCopy: markdownUrl } = Astro.locals.starlightRoute as {
  lang: string;
  markdownCopy?: string;
};
const isEs = routeLang.startsWith('es');

const markdownHref = markdownUrl ? new URL(markdownUrl, Astro.url.href).href : '';

/**
 * Translations inline, the same way PageTitle.astro and PageChips.astro carry
 * theirs. Starlight's `injectTranslations` is for plugins shipping their own
 * UI strings; a site component reads its own two locales directly.
 */
const t = isEs
  ? {
      copy: 'Copiar página',
      copied: 'Copiado',
      failed: 'No se pudo copiar',
      more: 'Más acciones para esta página',
      copyLink: 'Copiar enlace al Markdown',
      view: 'Ver como Markdown',
      chatgpt: 'Abrir en ChatGPT',
      claude: 'Abrir en Claude',
      cite: 'Copiar cita',
      // The prompt travels in a query string to a third party, so it names the
      // markdown copy rather than the page: that is the version worth reading.
      prompt: `Lee ${markdownHref} y responde preguntas sobre esta página.`,
    }
  : {
      copy: 'Copy page',
      copied: 'Copied',
      failed: 'Copy failed',
      more: 'More actions for this page',
      copyLink: 'Copy link to Markdown',
      view: 'View as Markdown',
      chatgpt: 'Open in ChatGPT',
      claude: 'Open in Claude',
      cite: 'Copy citation',
      prompt: `Read ${markdownHref} so I can ask questions about it.`,
    };

const q = encodeURIComponent(t.prompt);

/**
 * Starlight renders the right column twice, once for each breakpoint, and only
 * one of the two is ever displayed. Both copies are in the document all the
 * same, so the popup needs an id per instance: `aria-controls` has to resolve
 * to one element, and a duplicated id is a validation error besides.
 */
interface Props {
  variant: 'mobile' | 'sidebar';
}
const { variant } = Astro.props;
const menuId = `page-actions-menu-${variant}`;
---

{
  markdownUrl && (
    <div
      class="page-actions"
      data-markdown={markdownUrl}
      data-copied={t.copied}
      data-failed={t.failed}
    >
      {/*
        Both halves ship disabled and the script below enables them once it has
        wired them up. Everything they do needs it: the clipboard for the two
        that copy, and opening the popup for the one that opens it. A control
        that cannot act should say so rather than absorb the press, and with no
        script at all the state is simply never lifted.
      */}
      <div class="page-actions-split">
        <button type="button" class="page-action-copy" disabled data-copy>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
            <path
              d="M8 8h12v12H8z M4 16H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span data-copy-label>{t.copy}</span>
        </button>
        <button
          type="button"
          class="page-action-more"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls={menuId}
          aria-label={t.more}
          disabled
          data-toggle
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
            <path
              d="m6 9 6 6 6-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
      <div class="page-actions-menu" id={menuId} role="menu" hidden>
        {/*
          The link, not the text. `Copy page` above puts tens of thousands of
          characters on the clipboard, which is the right thing to hand a model
          that cannot browse and the wrong thing to hand one that can: a reader
          pasting into an agent with web access is better served by one URL it
          fetches itself, and by a paste that still fits in a chat box.
        */}
        <button type="button" role="menuitem" tabindex="-1" data-copy-text={markdownHref}>
          <span data-copy-label>{t.copyLink}</span>
        </button>
        <a role="menuitem" tabindex="-1" href={markdownUrl}>
          {t.view}
        </a>
        <a
          role="menuitem"
          tabindex="-1"
          href={`https://chatgpt.com/?q=${q}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.chatgpt}
        </a>
        <a
          role="menuitem"
          tabindex="-1"
          href={`https://claude.ai/new?q=${q}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.claude}
        </a>
        {/*
          Five entries is where a flat list starts reading as a wall, so the
          citation is set off by a rule rather than queued behind the others:
          the four above are all "give me this page", this one is "give me the
          project", and the separator is what says so without a submenu or a
          heading nobody would read.
        */}
        <div role="separator" />
        <button type="button" role="menuitem" tabindex="-1" data-copy-text={bibtex}>
          <span data-copy-label>{t.cite}</span>
        </button>
      </div>
      {/*
        One of the five entries is a plain navigation and needs nothing from
        the browser but a link, so with the popup shut for want of a script it
        is offered here instead of being unreachable. The other four cannot be:
        three of them copy, and the two handoffs carry the same address as this
        one anyway.
      */}
      <noscript>
        <a class="page-action-plain" href={markdownUrl}>
          {t.view}
        </a>
      </noscript>
    </div>
  )
}

<style>
  .page-actions {
    position: relative;
    margin-bottom: 1rem;
  }

  .page-actions-split {
    display: flex;
    width: 100%;
  }

  .page-actions-split button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.25rem 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    font: inherit;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    cursor: pointer;
  }

  .page-action-copy {
    flex: 1;
    border-radius: 0.25rem 0 0 0.25rem;
    border-inline-end-width: 0;
    /* The label swaps to "Copied" / "Copy failed", which are wider in Spanish;
       the button must not resize under the reader's cursor. */
    white-space: nowrap;
    overflow: hidden;
  }

  .page-action-more {
    border-radius: 0 0.25rem 0.25rem 0;
    flex: 0 0 auto;
  }

  .page-actions-split button:hover:not(:disabled) {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  /* Only the pointer is told: the colours stay as they are, because a control
     that is unavailable for the few milliseconds before its script runs must
     not flash a second appearance at every reader. */
  .page-actions-split button:disabled {
    cursor: default;
  }

  .page-actions-split button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    /* So the ring is not clipped by the neighbour's border. */
    position: relative;
    z-index: 1;
  }

  /* The no-script way through to the markdown copy. Styled as the plain link
     it is, since the split button above it is inert in that case. */
  .page-action-plain {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
  }

  .page-action-more[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .page-actions-menu {
    position: absolute;
    z-index: 10;
    inset-inline: 0;
    margin-top: 0.25rem;
    padding: 0.25rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    box-shadow: var(--sl-shadow-md);
  }

  .page-actions-menu[hidden] {
    display: none;
  }

  /* Beats the right-sidebar panel rule that styles every anchor in it as a
     table-of-contents line. The two entries that copy rather than navigate are
     buttons, because that is what they do, and they are reset to the same box
     so the menu reads as one list and not as links with a control among them. */
  .page-actions-menu :is(a, button):where(a, button) {
    display: block;
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 0;
    border-radius: 0.25rem;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .page-actions-menu :is(a, button):hover,
  .page-actions-menu :is(a, button):focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .page-actions-menu :is(a, button):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .page-actions-menu [role='separator'] {
    height: 1px;
    margin: 0.25rem;
    background: var(--sl-color-gray-5);
  }

  /* Under the sticky mobile table of contents the actions are a single row in
     the flow, so they scroll away with the article instead of eating height
     from a viewport that has little to spare. */
  @media (max-width: 71.9375rem) {
    .page-actions {
      margin: 0.75rem var(--sl-content-pad-x) 0;
    }
    /* Sized to its text rather than stretched across the article: at the top
       of every page a full-width bar reads as a banner, not as a tool. */
    .page-actions-split {
      width: fit-content;
    }
    .page-action-copy {
      flex: 0 0 auto;
    }
    .page-actions-menu {
      inset-inline: auto 0;
      min-width: 12rem;
    }
  }
</style>

<script>
  const COPIED_MS = 2000;

  for (const root of document.querySelectorAll<HTMLElement>('.page-actions')) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const menu = root.querySelector<HTMLElement>('[role="menu"]');
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    if (!toggle || !menu || !copy) continue;

    const items = () => [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')];

    const open = (focusIndex?: number) => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (focusIndex !== undefined) items()[focusIndex]?.focus();
    };

    const close = (returnFocus = true) => {
      if (menu.hidden) return;
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (returnFocus) toggle.focus();
    };

    // A press of the pointer leaves focus where it is: the reader is looking at
    // the menu and will click what they want. A press of the keyboard cannot,
    // because the entries are out of the tab order, so a keyboard reader left
    // standing on the toggle has an open menu and no way into it that the page
    // ever mentioned. `detail` is 0 only for a click the browser synthesised
    // from a key, which is what tells the two apart here.
    toggle.addEventListener('click', (event) => {
      if (!menu.hidden) close();
      else if (event.detail === 0) open(0);
      else open();
    });

    // Down and Up open the menu onto its first or last entry, the standard
    // keyboard entry points for a button that owns a popup. Enter and Space
    // arrive as the synthesised click above and land on the first entry too.
    toggle.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        open(0);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        open(items().length - 1);
      }
    });

    // Roving focus inside the popup: the entries are out of the tab order
    // (`tabindex="-1"`) and are reached with the arrow keys, so Tab still steps
    // past the whole control rather than through every entry.
    menu.addEventListener('keydown', (event) => {
      const all = items();
      const at = all.indexOf(document.activeElement as HTMLElement);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        all[(at + 1) % all.length]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        all[(at - 1 + all.length) % all.length]?.focus();
      } else if (event.key === 'Home') {
        event.preventDefault();
        all[0]?.focus();
      } else if (event.key === 'End') {
        event.preventDefault();
        all.at(-1)?.focus();
      } else if (event.key === 'Tab') {
        // Tab leaves the popup, so the popup should not stay open behind it.
        close(false);
      }
    });

    // Escape from anywhere in the control, and a click that lands outside it.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        event.stopPropagation();
        close();
      }
    });
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) close(false);
    });
    // Only the entries that navigate close the menu. The ones that copy report
    // back by swapping their own label, which nobody would see if the menu shut
    // underneath them, and closing would also drop focus from the entry the
    // keyboard is standing on.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close(false);
    });

    /**
     * Say what happened on the control that was pressed, then put its label
     * back. The original is remembered per button so a second press during the
     * two seconds cannot capture "Copied" as the text to restore.
     */
    const pending = new WeakMap<HTMLElement, { text: string; timer: number }>();
    const report = (button: HTMLElement, message: string) => {
      const target = button.querySelector<HTMLElement>('[data-copy-label]') ?? button;
      const previous = pending.get(button);
      if (previous) clearTimeout(previous.timer);
      const text = previous ? previous.text : (target.textContent ?? '');
      target.textContent = message;
      pending.set(button, {
        text,
        timer: window.setTimeout(() => {
          target.textContent = text;
          pending.delete(button);
        }, COPIED_MS),
      });
    };

    const toClipboard = async (button: HTMLElement, produce: () => Promise<string> | string) => {
      try {
        await navigator.clipboard.writeText(await produce());
        report(button, root.dataset.copied!);
      } catch (error) {
        console.error('[page-actions] could not copy:', error);
        report(button, root.dataset.failed!);
      }
    };

    copy.addEventListener('click', async () => {
      // The only network call in this component, and it is to this origin.
      copy.disabled = true;
      await toClipboard(copy, async () => {
        const response = await fetch(root.dataset.markdown!);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.text();
      });
      copy.disabled = false;
    });

    // The markdown URL and the citation are both known at build time and sit in
    // the markup, so these two fetch nothing at all. They are also never
    // disabled: a disabled menu item is not focusable, and taking focus off an
    // entry the reader is standing on would break the roving tab index.
    for (const entry of menu.querySelectorAll<HTMLElement>('[data-copy-text]')) {
      entry.addEventListener('click', () => toClipboard(entry, () => entry.dataset.copyText!));
    }

    // Everything is listening now, so the two halves can be pressed. They ship
    // disabled: without this script neither of them can do anything, and the
    // markup says so rather than looking ready and swallowing the press.
    copy.disabled = false;
    toggle.disabled = false;
  }
</script>
