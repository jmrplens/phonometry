---
/**
 * One published catalogue, rendered from site/src/generated/catalogues.mjs.
 *
 * The rows are the library's own: `PUBLISHED_SOLIDS`, `PUBLISHED_POROUS` and
 * `PUBLISHED_FLUIDS`, dumped by scripts/generate_catalogue_data.py so that
 * what this page shows is what the package holds and not a second
 * transcription of the same books. Until this page existed they could only be
 * read by importing the library or by opening the JSON data files in the
 * repository, which is a strange place to send someone who wants to know what
 * density a book prints for lead.
 *
 * A table is the right shape here, which is the opposite of the conclusion the
 * glossary reached: that page is sentences, and a sentence in a 135 px column
 * is unreadable, while these are numbers, and a number wants its neighbours
 * above and below it to compare against. So the tables stay tables and scroll
 * horizontally inside their own box, with the material name frozen at the left
 * edge so a reader who has scrolled to the transverse speed still knows whose
 * it is.
 *
 * What a cell can be is the whole point of the catalogues, so it is the whole
 * point of this rendering too. A page prints a density as an interval, a loss
 * factor as an upper bound, a characteristic length as three readings from
 * three studies, or a tortuosity as the word "model"; the library keeps each
 * of those as what it is, and here each gets its own mark and its own
 * explanation on hover and on focus. A number this library worked out from the
 * cells a page did print is marked too, because a reader comparing two books
 * needs to know which of the two numbers in front of them was ever published.
 *
 * Everything is rendered at build time and nothing is a framework island, the
 * same arrangement Conformance.astro and Glossary.astro use: with JavaScript
 * off the page is the whole catalogue and only the filters are missing, and
 * Pagefind indexes every row.
 *
 * One catalogue per invocation, and the heading above it belongs to the page
 * rather than to this component. A heading rendered inside a component never
 * reaches Starlight's table of contents, so a page whose three sections came
 * from here offered a reader one entry, "Overview", and no way to jump to the
 * fluids. The prose that introduces each catalogue is in the page for the same
 * reason it always is: it is prose, and it is translated as prose.
 */
import {
	catalogues,
	type CatalogueCell,
	type CatalogueRow,
	type CatalogueTextField,
} from '../generated/catalogues.mjs';

interface Props {
	/** Which catalogue to render. */
	catalogue:
		| 'solids'
		| 'damping'
		| 'dampingTreatments'
		| 'orthotropicWood'
		| 'plateau'
		| 'porous'
		| 'flowResistance'
		| 'resilientLayers'
		| 'resilientModuli'
		| 'ground'
		| 'gases'
		| 'absorption'
		| 'carpets'
		| 'absorptionAreas'
		| 'transmissionLoss'
		| 'impactInsulation'
		| 'ductTransmissionLoss'
		| 'scattering'
		| 'diffusion'
		| 'predictedScattering'
		| 'fluids'
		| 'nonlinearity'
		| 'solidNonlinearity'
		| 'airAttenuation';
	/** Locale of the page it is rendered on. */
	lang?: 'en' | 'es';
}
const { catalogue: section, lang = 'en' } = Astro.props;

// The search placeholders are suggestions a reader types, so each one has to
// find rows on the page it is shown on. The Spanish page matches the Spanish
// words the generator attached to every row as well as the book's own English,
// so its suggestions are Spanish; they were English, on purpose, while the
// Spanish page matched only the book's words and "hierba" found nothing.
// tests/test_catalogue_data_generator.py checks that every word of every
// suggestion still finds a row in its own catalogue, in each language.
const copy = {
	en: {
		search: 'Filter by material',
		searchGas: 'Filter by gas',
		searchFacing: 'Filter by facing',
		searchFloor: 'Filter by floor',
		searchDuct: 'Filter by duct',
		searchCondition: 'Filter by condition',
		searchPlaceholder: 'steel, foam, glass',
		groundPlaceholder: 'grass, snow, asphalt',
		gasPlaceholder: 'methane, argon, steam',
		liquidPlaceholder: 'water, ethanol, mercury',
		treatmentPlaceholder: 'muescado, alfombra',
		carpetPlaceholder: 'nylon, lana, rizo',
		resilientModulusPlaceholder: 'rock wool, cork',
		solidNonlinearityPlaceholder: 'FCC, NaCl, ionic',
		absorptionPlaceholder: 'carpet, plaster, velour',
		partitionPlaceholder: 'brick, door, glass',
		scatteringPlaceholder: 'pyramid, hemisphere, holly',
		woodPlaceholder: 'spruce, maple',
		plateauPlaceholder: 'steel, glass, brick',
		porousPlaceholder: 'glass wool, foam, felt',
		areaPlaceholder: 'audience, musician, air',
		geometryPlaceholder: 'h/L = 20, w = 10 cm',
		fluidPlaceholder: 'water, mercury, steam',
		diffusionPlaceholder: 'semiellipse, triangle, QRD',
		dampingPlaceholder: 'DYAD, ISD, Soundcoat',
		facingPlaceholder: 'FM 125, 1584, 40',
		resilientPlaceholder: 'polystyrene, wool, foam',
		floorPlaceholder: 'hormigón, moqueta, viguetas',
		ductPlaceholder: '610, round, break-in',
		conditionPlaceholder: '20 °C, 50-70',
		empty: 'No row matches that filter.',
		material: 'Material',
		surface: 'Surface',
		gas: 'Gas',
		finish: 'Finish',
		partition: 'Construction',
		facing: 'Facing',
		floor: 'Floor or treatment',
		duct: 'Duct',
		condition: 'Condition',
		state: 'State',
		substance: 'Substance',
		treatment: 'Treatment',
		construction: 'Construction',
		structure: 'Material or structure',
		conditions: 'Conditions',
		mounting: 'Mount',
		per: 'Per',
		solver: 'Computed with',
		direction: 'Direction',
		shape: 'Shape',
		gauge: 'Sheet gauge',
		weave: 'Weave',
		bonding: 'Bonding',
		fixedBy: 'What fixes it',
		source: 'Source',
		regionLabel: 'Published values, scrollable sideways',
		legend: 'Italic is a value this library worked out; a dotted underline is a cell that is not a plain number, and what it is reads on the cell; an asterisk is a note the page made about the row. Click a mark to read it, or give the table focus and press Enter to walk the marks with the arrow keys.',
		kinds: {
			printed: 'as the page prints it',
			fixed: 'what the model or the standard beside it fixes',
			derived: 'worked out by this library',
			converted: 'converted from the page\'s figure',
			carried: 'the page gives this value on another of its rows',
			approximate: 'the page prints it with a tilde',
