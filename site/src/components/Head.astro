---
// Custom Starlight <Head> override.
//
// Renders Starlight's default head, then layers the per-page structured data
// and the per-page Twitter card tags on top. The site-wide @graph (Person /
// WebSite / SoftwareApplication / SoftwareSourceCode) lives in
// astro.config.mjs; the nodes here join it by `@id`.
//
// Everything per-page goes into ONE `@graph` rather than a script per node.
// Google merges every ld+json block on a page before evaluating, so the old
// split worked there, but a plain JSON-LD processor expands each <script> as
// its own document, and in that reading the `@id`s below pointed at nodes with
// no properties. The naive parsers are exactly the consumers this markup is
// for, so the graph is assembled here instead of hoping it is reassembled
// downstream.
import Default from '@astrojs/starlight/components/Head.astro';
import { breadcrumbsFor } from '../lib/breadcrumbs.mjs';
import { topicForSlug } from '../data/topics.mjs';
import { firstPublished } from '../lib/page-dates.mjs';
import { isoDay } from '../lib/date-rules.mjs';
import {
  citationsFor,
  correctedWorks,
  englishStandardIds,
  referenceNode,
  referenceStub,
  standardsBody,
} from '../lib/citations.mjs';
import { bibliographyWorks, referencesOfEveryPage } from '../lib/bibliography-works';
import { pageEvidence } from '../lib/page-evidence';
import { conformanceDataset } from '../lib/conformance-dataset.mjs';
import { loadContentDates } from '../lib/content-dates.mjs';
import { report as conformanceReport } from '../data/conformance-stats.mjs';
import { pageStandardTokens } from '../lib/standard-search.mjs';
import { prose } from '../lib/markdown-fences.mjs';
import { targetPlatform, version } from '../data/repo-stats.mjs';
import { personId as PERSON_ID, siteUrl } from '../data/site.mjs';
import { englishTwin, isApiRoute, isFallbackRoute } from '../lib/fallback-routes.mjs';
import { catalogueOverview, cataloguePages } from '../lib/catalogue-pages';
import { datasetNode, datasetStub } from '../lib/catalogue-datasets.mjs';
import { isCataloguePage } from '../lib/catalogue-sources.mjs';
import { catalogues } from '../generated/catalogues.mjs';

const SITE = import.meta.env.SITE ?? siteUrl;
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const WEBSITE_ID = `${SITE}${BASE}/#website`;
const SOFTWARE_ID = 'https://github.com/jmrplens/phonometry#software';
const SOCIAL_IMAGE = `${SITE}${BASE}/og-image.png`;

interface ReferenceEntry {
  type: string;
  title: string;
  designation?: string;
  organization?: string;
  publisher?: string;
  institution?: string;
  authors?: string[];
  year?: number | string;
  url?: string;
  doi?: string;
  note?: string;
  primary?: boolean;
  /** `false` on a document the page cites but does not implement. */
  implemented?: false;
  [key: string]: unknown;
}
interface RouteData {
  entry?: {
    id?: string;
    filePath?: string;
    data?: {
      title?: string;
      description?: string;
      references?: ReferenceEntry[];
      searchTitle?: string;
      /** The works an errata page corrects, by their `@id` fragment (src/content.config.ts). */
      corrects?: string[];
    };
  };
  lastUpdated?: Date;
  /** Set in src/routeData.ts; absent on the pages that publish no copy. */
  markdownCopy?: string;
}
const route = (Astro.locals as { starlightRoute?: RouteData }).starlightRoute;
const data = route?.entry?.data ?? {};
const title = data.title ?? 'phonometry';
const description = data.description ?? '';

// A Spanish API page is the English page served under /es/ as fallback
// content (src/lib/fallback-routes.mjs), and its graph says so: every address,
// the language and the trail below are its English twin's, so the two copies
// publish the same structured data, as Google asks of duplicate pages, and the
// one they name is the canonical one src/routeData.ts writes into the head.
const pathname = Astro.url.pathname; // e.g. /phonometry/signals/levels/levels/
const ownPath = isFallbackRoute(pathname, BASE) ? englishTwin(pathname, BASE) : pathname;
const canonical = new URL(ownPath, SITE).href;
const rel = ownPath.startsWith(BASE) ? ownPath.slice(BASE.length) : ownPath;
const lang = rel.startsWith('/es/') || rel === '/es' ? 'es' : 'en';
const isHome = rel === '/' || rel === '' || rel === '/es/' || rel === '/es';

// Per-page Open Graph card, generated at build time by src/pages/og. Every
// documentation page has one carrying its own title and its area's artwork;
// the docstring-generated API tree does not, and falls back to the site-wide
// card. The path mirrors the page's own, so no lookup table is needed.
//
// The 404 route is excluded too. Starlight synthesises it with the entry id
// "404" whether or not a page file exists, so it is not in the docs collection
// and src/pages/og never enumerates it: claiming a card here would advertise
// an image that is never written, and nothing in the build would notice.
const entryId = route?.entry?.id ?? '';
const hasOwnCard =
  entryId !== '' && entryId !== '404' && !/^(es\/)?reference\/api\//.test(entryId);
const ogImage = hasOwnCard
  ? `${SITE}${BASE}/og/${entryId.replace(/\/index$/, '') || 'index'}.jpg`
  : SOCIAL_IMAGE;

// The 404 page is a real route with a real entry, so it used to emit a
// TechArticle headlined "404" carrying the site description. An error page is
// not an article and should not be indexed as one.
const is404 = route?.entry?.id === '404' || rel.replace(/\/$/, '').endsWith('/404');

// Slug without the locale prefix: `guides/levels` for both languages. This is
// the key the navigation tree and the translation pairing both use.
const slug = rel.replace(/^\/(es\/)?/, '').replace(/\/$/, '');

// The generated API tree documents modules, and schema.org has an exact type
// for that. APIReference is a subclass of TechArticle, so nothing is lost.
const isApiPage = slug.startsWith('reference/api/');
// The API reference in either language, its index included: the pairs that
// are one English text and so declare no translation of each other.
const isUntranslated = isApiRoute(slug);
// The topic that owns this page, resolved from the array the sidebar, the
// breadcrumb trails and the topic switcher all read. It answers two questions
// at once: whether the page teaches, and what to call its section in the
// reader's own language.
//
// Both used to be answered here by lists written out by hand, and the second
// one drifted. The signal chapter was renamed `signals` and the topic list
// twelve lines up was swept, but the section-name map below it kept saying
// `signal`, so a topic of 54 pages published no `articleSection` at all on any
// of them while its breadcrumbs, which read topics.mjs, stayed right the whole
// time. Reading the same file removes the second spelling rather than
// correcting it.
const topic = topicForSlug(slug);
// Guides teach a method as well as document it; the dual type is free and adds
// the learning-resource properties.
const isGuide = topic?.isDomain ?? false;
// Human-readable section for articleSection, in the page's own language.
const articleSection = topic?.label[lang];
const isBibliography = slug === 'reference/bibliography';
// The overview of the published catalogues, which lists them all.
const isCatalogueOverview = slug === 'reference/catalogues';

const bibliographyUrl = `${SITE}${BASE}${lang === 'es' ? '/es' : ''}/reference/bibliography/`;
const englishBibliographyUrl = `${SITE}${BASE}/reference/bibliography/`;

// Dates: `dateModified` is the day the page's content last changed, which
// src/routeData.ts sets as the route's `lastUpdated` from
// src/lib/content-dates.mjs, so it is the day the footer shows and the
// sitemap's <lastmod> carries. `datePublished` is the commit that ADDED the
// page. They used to be the same value, which claimed every page was published
// on the day it was last edited. Both are days in UTC, from the `isoDay` of
// src/lib/date-rules.mjs that the first-publication dates and the sitemap use.
const modified = route?.lastUpdated instanceof Date ? isoDay(route.lastUpdated) : undefined;
const published = firstPublished(route?.entry?.filePath ?? '') ?? modified;

// The hub pages exist to enumerate their children, and schema.org has a type
// for exactly that. Dual-typed so nothing consuming the TechArticle reading
// loses properties it already relied on.
const isHub =
  slug === 'start/guides' || slug === 'reference' || slug === 'reference/api';

// The About page says who maintains the library, on what record, and how its
// numbers are made, and schema.org has a page type for exactly that. It is
// dual-typed like the hubs, so the TechArticle reading keeps what it had.
const isAboutPage = slug === 'start/about';

const articleType = isApiPage
  ? 'APIReference'
  : isGuide
    ? ['TechArticle', 'LearningResource']
    : isHub
      ? ['CollectionPage', 'TechArticle']
      : isCatalogueOverview
        ? ['TechArticle', 'DataCatalog']
        : isAboutPage
          ? ['AboutPage', 'TechArticle']
          : 'TechArticle';

// Every published catalogue is a Dataset of the page that renders it, and
// the overview of the catalogues is the DataCatalog that lists them
// (src/lib/catalogue-datasets.mjs says what a dataset carries and why it
// claims no licence). A catalogue page's article names its datasets as its
// `mainEntity`; the datasets themselves are nodes of the page's graph, each
// dated as the page is.
const catalogueCatalog =
  isCataloguePage(entryId) || isCatalogueOverview ? await catalogueOverview(lang) : undefined;
const dataCatalog = catalogueCatalog
  ? {
      '@id': `${new URL(catalogueCatalog.href, SITE).href}#article`,
      name: catalogueCatalog.title,
      url: new URL(catalogueCatalog.href, SITE).href,
    }
  : undefined;
const cataloguePage = isCataloguePage(entryId)
  ? (await cataloguePages(lang)).find((page) => page.id === entryId)
  : undefined;
const datasets =
  cataloguePage && dataCatalog
    ? cataloguePage.datasets.map((dataset) =>
        datasetNode({
          dataset,
          catalogue: catalogues[dataset.key],
          references: data.references ?? [],
          lang,
          pageUrl: canonical,
          twinUrl: `${SITE}${BASE}${lang === 'en' ? '/es' : ''}/${slug}/`,
          bibliographyUrl,
          dataCatalog,
          dateModified: modified,
        }),
      )
    : [];
const catalogueListing = isCatalogueOverview
  ? (await cataloguePages(lang)).flatMap((page) =>
      page.datasets.map((dataset) => datasetStub(dataset, new URL(page.href, SITE).href)),
    )
  : undefined;
const datasetIds = datasets.map((dataset) => ({ '@id': dataset['@id'] }));

// The guides hub already publishes its areas as a hand-authored ItemList in
// the page frontmatter; CollectionPage.mainEntity is the hook that ties the
// page node to that list instead of leaving two disconnected nodes. A
// catalogue page's main entity is its catalogue, or its two on the page that
// renders two.
const pageEntity =
  slug === 'start/guides'
    ? { '@id': `${canonical}#areas` }
    : datasetIds.length > 1
      ? datasetIds
      : datasetIds[0];

// The conformance report page is about the report, and the report is a
// Dataset (src/lib/conformance-dataset.mjs): it is the article's main
// entity, in the page's language, dated by the last commit of the data it
// renders, handing out its files at that commit, and naming every standard
// its checks quote. Those standards are
// joined to the works the pages cite by src/lib/conformance-evidence.mjs
// (src/lib/page-evidence.ts), which fails the build on one it cannot name.
const isConformanceReport = slug === 'reference/conformance';
let reportDataset: object | undefined;
if (isConformanceReport && !is404) {
  const evidence = await pageEvidence(lang);
  const data = (await loadContentDates()).sourceCommit('docs/conformance.json');
  reportDataset = conformanceDataset({
    lang,
    canonical,
    report: conformanceReport,
    modified: isoDay(data.date),
    commit: data.sha,
    standards: evidence.governing.map((ref) => referenceStub(ref, bibliographyUrl)),
    personId: PERSON_ID,
    softwareId: SOFTWARE_ID,
  });
}
const mainEntity = pageEntity ?? reportDataset;

// Word count of the page source, with the machinery that is not prose (MDX
// imports, component tags, fenced code) stripped first. An approximation, but
// an honest one: it moves with the text, not with the markup around it.
const rawBody = (route?.entry as { body?: string } | undefined)?.body ?? '';
const proseBody = prose(rawBody)
  .replace(/^import\s.+$/gm, ' ')
  .replace(/<\/?[A-Za-z][^>]*>/g, ' ');
const wordCount = proseBody.split(/\s+/).filter(Boolean).length;

// The works the page cites (src/lib/citations.mjs). `governingWorks` is a
// convenience name schema.org has no property for: those works go into
// `about`, beside the software.
const { governingWorks, ...cited } = citationsFor({ references: data.references, bibliographyUrl });

// An errata page is about the works its entries correct, which it names in
// `about` beside the software, each as the bibliography describes it
// (src/lib/citations.mjs, correctedWorks). They come from the page's own
// `corrects`, never from `references`, which would also make the page's chips
// and its search tokens and rank it with the guides written to those works.
const corrected = data.corrects?.length
  ? correctedWorks(data.corrects, await bibliographyWorks(lang, bibliographyUrl), bibliographyUrl)
  : [];
const aboutWorks = [...(governingWorks ?? []), ...corrected];

const article =
  isHome || is404
    ? null
    : {
        '@type': articleType,
        '@id': `${canonical}#article`,
        headline: title,
        // A DataCatalog is named, as every dataset it lists is.
        ...(isCatalogueOverview ? { name: title } : {}),
        ...(description ? { description } : {}),
        inLanguage: lang,
        url: canonical,
        mainEntityOfPage: canonical,
        image: ogImage,
        // Point voice/AI assistants at the page title and lead paragraph.
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.sl-markdown-content > p:first-of-type'],
        },
        ...(published ? { datePublished: published } : {}),
        ...(modified ? { dateModified: modified } : {}),
        ...(wordCount ? { wordCount } : {}),
        ...(articleSection ? { articleSection } : {}),
        ...(mainEntity ? { mainEntity } : {}),
        ...(catalogueListing ? { dataset: catalogueListing } : {}),
        ...(isGuide ? { learningResourceType: 'Guide' } : {}),
        // The language and the repository are the software's, said once on
        // the node `about` names: schema.org defines programmingLanguage and
        // codeRepository on SoftwareSourceCode, not on an APIReference
        // (site/scripts/check-schema-vocabulary.mjs fails on them here).
        ...(isApiPage
          ? {
              programmingModel: 'Library API',
              executableLibraryName: 'phonometry',
              // The version VERSION names in the tree this reference is
              // generated from, and the Python pyproject.toml requires, both
              // through repo-stats.mjs.
              assemblyVersion: version,
              targetPlatform,
            }
          : {}),
        // The two language versions are one work, not two pages competing for
        // the same query. The API reference has one version only.
        ...(isUntranslated
          ? {}
          : {
              [lang === 'en' ? 'workTranslation' : 'translationOfWork']: {
                '@id': `${SITE}${BASE}${lang === 'en' ? '/es' : ''}/${slug}/#article`,
              },
            }),
        author: { '@id': PERSON_ID },
        publisher: { '@id': PERSON_ID },
        isPartOf: { '@id': WEBSITE_ID },
        // `isBasedOn` and `citation`, in that order, then `about`: each work is
        // named where it is first referenced and pointed at after, so the
        // standards the page is based on are named where a reader looks for
        // them, and `about` lists the same ones beside the software. An errata
        // page cites nothing, and its `about` names the works it corrects.
        ...cited,
        about: aboutWorks.length ? [{ '@id': SOFTWARE_ID }, ...aboutWorks] : { '@id': SOFTWARE_ID },
      };

// The bibliography page is where every cited work is defined in full. Other
// pages name each work once, briefly, and point at its `@id`; here the full
// nodes are emitted once per language, with the standards bodies they cite.
let bibliographyNodes: unknown[] = [];
if (isBibliography) {
  const bodies = new Map<string, unknown>();
  const pages = await referencesOfEveryPage();
  // A Spanish standard names the English node it is (`sameAs`), so the two
  // bibliographies read as one set of works in two languages.
  const twins =
    lang === 'es' ? englishStandardIds(pages, bibliographyUrl, englishBibliographyUrl) : new Map();
  // Only this locale's works (src/lib/bibliography-works.ts says why), the
  // set an errata page names the works it corrects from.
  const works = [...(await bibliographyWorks(lang, bibliographyUrl))].map(([id, ref]) => {
    // The body is defined on the English bibliography's address in both
    // languages: one identity for ISO, not one per page that names it.
    const body = standardsBody(ref, englishBibliographyUrl);
    if (body && !bodies.has(body['@id'])) bodies.set(body['@id'], body);
    return referenceNode(ref, bibliographyUrl, {
      bodiesUrl: englishBibliographyUrl,
      translationOf: twins.get(id) ?? [],
    });
  });
  bibliographyNodes = [...bodies.values(), ...works];
}

// The home page is the one route with no article node, which left it as the
// only page without a speakable target. A WebPage node carries the same
// pointer the article pages already give voice/AI assistants; the tagline is
// the home page's one-sentence definition of the library.
const homePage =
  isHome && !is404
    ? {
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: title,
        ...(description ? { description } : {}),
        inLanguage: lang,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.hero .tagline'],
        },
        ...(modified ? { dateModified: modified } : {}),
        isPartOf: { '@id': WEBSITE_ID },
        about: { '@id': SOFTWARE_ID },
      }
    : null;

const crumbs =
  isHome || is404
    ? null
    : breadcrumbsFor({ slug, title, lang, origin: SITE, base: BASE });

const breadcrumbList = crumbs
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: crumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: crumb.item,
      })),
    }
  : null;

// Search tokens for the standards this page implements, from the same
// `references` frontmatter the chips and the References section come from (an
// entry marked `implemented: false` is printed there and indexed nowhere else). They
// become a Pagefind metadata field, weighted in src/lib/search-ranking.mjs, so
// that a search for a designation ranks the guides written to it first instead
// of the pages that happen to say the number most often.
//
// The head is the right place for this and the chips paragraph is not: that
// paragraph is only painted when the page has at least one chip, which is a
// layout condition. A page whose only standard produced no chip would lose
// every token with nothing in the build to notice. The head always exists.
const standardTokens = pageStandardTokens(data.references);

const graph = [article, homePage, breadcrumbList, ...datasets, ...bibliographyNodes].filter(Boolean);
const jsonLd = graph.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  : null;
---

<Default><slot /></Default>
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
{/* og:type is set per page in frontmatter, not here: appending a second
    og:type would leave both in the document, and Open Graph parsers take the
    first occurrence, so the override would silently lose. Starlight's head
    merge deduplicates by property, which the frontmatter route goes through. */}
{/* A clean markdown copy of this page sits beside it (postbuild step
    scripts/emit-page-markdown.mjs). Advertising it lets an agent fetch the
    prose without parsing ~90% chrome out of the HTML. The address comes from
    src/routeData.ts, which knows which pages the generator wrote one for: it
    is absent on the 404 and on the pages src/lib/page-markdown.mjs withholds
    (the splash pages, and the pages that show their data through a component
    with no copy in docs/), and on a page served as fallback content it is
    the copy of the entry actually rendered here. */}
{route?.markdownCopy && (
  <link rel="alternate" type="text/markdown" href={route.markdownCopy} />
)}
{/* The designations this page declares, as a Pagefind metadata field. The
    `name` attribute is not decoration: html-validate rejects a <meta content>
    without one of name, http-equiv, itemprop or property. The value is a list
    of index tokens, never shown to a reader; src/styles/search.css hides the
    tag the default result list would otherwise print from it. */}
{standardTokens.length > 0 && (
  <meta
    name="phonometry-standards"
    data-pagefind-meta="standards[content]"
    content={standardTokens.join(' ')}
  />
)}
{/* The title the site search ranks this page by, when it is not the page's
    own, an empty one included: an errata page is titled after a document it
    does not implement and after the register, and the five-fold boost
    Pagefind gives a title would put it above the guides written to that
    document and above the registry's index (src/lib/search-ranking.mjs).
    Pagefind takes an explicit `title` field over the page's h1, empty or not;
    `display_title` ranks nothing and is what the search panel shows
    (src/lib/search-ui.mjs). */}
{data.searchTitle !== undefined && (
  <>
    <meta name="phonometry-search-title" data-pagefind-meta="title[content]" content={data.searchTitle} />
    <meta name="phonometry-display-title" data-pagefind-meta="display_title[content]" content={title} />
  </>
)}
{/* The page's one og:locale: src/routeData.ts drops Starlight's bare `en`
    or `es`, which the protocol's language_TERRITORY form replaces. The API
    reference exists in English only, so it names no alternate. */}
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
{!isUntranslated && (
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
)}
{/* These are the document's only og:image and twitter:image. Starlight's
    head merge covers its own defaults, astro.config.mjs and frontmatter, but
    not tags written here, so nothing deduplicates them: astro.config.mjs
    deliberately emits neither, and re-adding one there would render first,
    inside <Default/>, and win on every page. */}
<meta property="og:image" content={ogImage} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
