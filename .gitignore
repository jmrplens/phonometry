# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# The Python build-artifact rule above also matches the site's source
# helpers directory and the phonometry.dev Worker's, which are real source
# and must stay tracked.
!site/src/lib/
!site/worker/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.env
.venv
env/
venv/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.iml
.DS_Store

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Project specific generated files
# CI-generated PR-comment artifact
pr_comment_body.md
*.wav
# ISO 532-1 normative validation signals are tracked explicitly
# (see tests/data/iso532_1/README.md for provenance and ISO attribution)
!tests/data/iso532_1/**/*.wav
!tests/data/iso532_1/*.wav
# Real measurement audio with published values is tracked explicitly
# (see tests/data/audio/README.md for provenance, licences and attribution)
!tests/data/audio/**/*.wav
!tests/data/audio/**/*.WAV
tests/*.png
# Figures written next to whatever was being run. Every figure the project
# keeps is generated into its own directory by scripts/, so a PNG at the root
# is a scratch file that was committed by accident.
/*.png
# One JUnit report per matrix job, written by the test run and uploaded as a
# workflow artifact. The comment step downloads them; nothing reads a copy
# committed here.
test-results-*/
test-results-*.xml
snyk.sarif
issues_final*.json
node_modules/

# Local work plans (brainstorming specs, implementation plans, source library)
/plan
docs/superpowers/

# Full copies of the heavy oracle sets that cannot be redistributed (the
# stipa.info certified STIPA bench, the EBU loudness test set, the NORAH2
# public release). Tests prefer them when present and otherwise fall back to
# the committed derived data and extracts under tests/data/, which is what CI
# runs. See tests/data/README.md and tests/oracle_data.py.
tests/data-local/

# Astro docs site
site/node_modules/
site/dist/
site/.astro/
# The phonometry.dev Worker's staged build and wrangler's local state
# (site/worker/README.md).
site/worker/stage/
site/worker/.wrangler/
site/worker/guard/.wrangler/

# The llms files the site publishes: llms.txt, llms-full.txt and the shards
# under llms/, written into site/public/ before the build by
# `scripts/generate_llms.py --build` from the Markdown copies of the pages,
# whose headers carry the dates git gives each page, which no committed file
# can carry. Only the dateless index, llms.txt at the repository root, is
# committed (`make llms`); /llms-full.txt is where the old layout kept the
# full text.
site/public/llms*.txt
site/public/llms/
/llms-full.txt
stub/dist/
stub/src/*.egg-info/
.playwright-mcp/

# Documentation media staged into the site by scripts/stage-media.mjs from
# .github/images and .github/reports, which are the committed originals.
site/public/media/

# The Markdown copy of every page, written into site/public/ before the build
# by `node scripts/agent-md.mjs --public` from the page sources, which are the
# committed originals.
site/public/**/index.md
site/lighthouse-results/

# Fiches a snippet writes where it was run. The guides show `.report("x.pdf")`
# with a bare filename, which is the honest way to document it, so running one
# to check a number drops the PDF in whatever directory you were standing in.
# Seventeen of them reached the repository root that way. The originals live in
# .github/reports and are committed from there, so nothing at the root is ever
# wanted.
/*.pdf

# The freshness check takes this lock while it rewrites the manifest.
scripts/animation_fingerprints.lock

# Scratch of the CI step that lists the published clips (python-app.yml)
assets-tree/
assets-manifest.txt
