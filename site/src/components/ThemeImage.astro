---
/**
 * Theme-aware figure pair following the site convention for the images
 * generated by scripts/generate_graphs.py and scripts/generate_diagrams.py:
 * every figure ships in four variants, `_es` for the Spanish edition and
 * `_dark` for the dark palette, both as suffixes before the extension. Both
 * are derived here, from the page's own language and from the theme, the way
 * Video.astro already derives them: a page names the plain figure and gets
 * the one that belongs to it. Naming the `_es` variant by hand is what nine
 * Spanish pages got wrong, and nothing could see it.
 *
 * Authoring a figure used to mean two hand-written <img> tags
 * with the alt text duplicated; this component takes the light URL and one
 * alt and emits the same light-only/dark-only pair, so the rendered HTML —
 * and the CSS switch plus the responsive width tiers in
 * src/styles/theme-images.css, keyed on the inline `width:NN%` style — is
 * unchanged.
 */
interface Props {
	/**
	 * URL of the plain figure: no `_es`, no `_dark`. Both suffixes are added
	 * here, so the same `src` serves the English page and its Spanish twin.
	 */
	src: string;
	/** Alternative text, required and shared by both theme variants. */
	alt: string;
	/**
	 * Authored display width tier, e.g. "80%" (see theme-images.css:
	 * 60/70 small schematics, 80 detailed plots, 88/92 wide diagrams).
	 * Emitted as the inline style the responsive tiers key on.
	 */
	width?: string;
	/** Native lazy-loading. Pass "eager" for a page's above-the-fold figure. */
	loading?: 'lazy' | 'eager';
}

import { Zoom } from 'starlight-image-zoom/components';

import { figureSize } from '../lib/figure-size.mjs';
import { mediaUrl } from '../lib/media.mjs';
import ZoomI18n from './ZoomI18n.astro';

const { src, alt, width, loading = 'lazy' } = Astro.props;
const { lang } = Astro.locals.starlightRoute;

if (!alt?.trim()) {
	throw new Error(`ThemeImage requires a non-empty alt (src: ${src})`);
}
if (/_es(_dark)?\.[A-Za-z0-9]+$/.test(src)) {
	throw new Error(
		`ThemeImage adds the language suffix itself; pass the plain figure ` +
			`instead of "${src}", which would resolve to _es_es.`,
	);
}
const suffixed = (base: string, suffix: string) =>
	base.replace(/(\.[A-Za-z0-9]+)$/, `${suffix}$1`);

// The page's language picks the edition, the CSS switch picks the palette.
const localised = lang.startsWith('es') ? suffixed(src, '_es') : src;
const darkSrc = suffixed(localised, '_dark');
if (darkSrc === localised) {
	throw new Error(`ThemeImage could not derive the dark variant of "${src}"`);
}
const style = width ? `width:${width}` : undefined;

// Serve this site's own copy rather than hotlinking the repository. The
// authored URL stays absolute so the docs/ mirror keeps working on GitHub.
const lightUrl = mediaUrl(localised);
const darkUrl = mediaUrl(darkSrc);

// Intrinsic size, so the browser can reserve the right box before the bytes
// arrive. Both variants are the same figure in two palettes and so share a
// ratio; the light one is measured. Undefined when the figure is not a local
// SVG, in which case no attributes are emitted and nothing changes.
const size = figureSize(localised);

// `display:none` stops a LAZY fetch but not an EAGER one, so an eager pair
// downloads both palettes and throws one away, about 37 kB on the landing page,
// and it does so whichever theme the reader is in.
//
// Both variants are lazy instead, which lets `display:none` suppress the one
// that is not shown. A lazy image inside the viewport is still fetched right
// away (lazy only defers what is offscreen), so the visible variant is not
// delayed, and `fetchpriority="high"` restores the head start that `eager`
// was there to give it.
const priority = loading === 'eager' ? 'high' : undefined;
const effectiveLoading = 'lazy';
---

{/*
	Same-line pair, matching the hand-authored markup this replaces, each half
	wrapped in the plugin's <Zoom> so the figure opens full-viewport like any
	other. The wrapping has to be explicit here: starlight-image-zoom finds
	images by walking the markdown tree, which reaches the hand-written <img>
	pairs on the theory pages but never sees the ones a component emits, so
	without this the guides would be the half of the site whose figures do not
	zoom. ZoomI18n translates the button label on the Spanish pages; the
	elements stay adjacent inside it so the pair keeps flowing as one figure.
*/}
<ZoomI18n><Zoom label={alt}><img
	class="light-only"
	src={lightUrl}
	alt={alt}
	style={style}
	loading={effectiveLoading}
	fetchpriority={priority}
	width={size?.width}
	height={size?.height}
/></Zoom><Zoom label={alt}><img
	class="dark-only"
	src={darkUrl}
	alt={alt}
	style={style}
	loading={effectiveLoading}
	fetchpriority={priority}
	width={size?.width}
	height={size?.height}
/></Zoom></ZoomI18n>
