---
/**
 * The conformance report, rendered from docs/conformance.json at build time.
 *
 * The page used to be the whole of docs/CONFORMANCE.md transplanted into the
 * body as text: 109 kB of Markdown table in English, copied a second time into
 * the Spanish page with one translated heading. A table of 554 rows is the
 * right shape for the data and the wrong one for the questions a reader
 * actually has, and as text it could answer none of them, because the number
 * that matters most was not in it: the *limit* each check is judged against
 * never left the comparison.
 *
 * The artefact carries the limit and the deviation as numbers, so this page can
 * rank every check by the fraction of its published tolerance it consumes -
 * which for a metrology library is the standing question, and one 554 static
 * rows never surfaced. It can also filter by domain and verdict, search by
 * designation, collapse the passing rows one at a time rather than a whole
 * 60-row domain because one row in it failed, give every row an anchor a review
 * comment can link to, and print m/s² rather than the m/s^2 a Markdown cell
 * carried.
 *
 * Everything is rendered at build time and nothing is a framework island. The
 * site ships no client components, Pagefind indexes the built HTML, and a page
 * that assembled its rows in the browser would delete 554 of them from the
 * search index and from every reader without JavaScript. The filtering is an
 * inline script over rows that are already in the document - the same
 * arrangement Glossary.astro, Sidebar.astro and PageActions.astro use - so with
 * the script disabled the page is the full report and only the controls are
 * missing.
 */
import { getEntry } from 'astro:content';

interface Props {
	/** Locale of the page the report is rendered on. */
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const entry = await getEntry('conformance', 'report');
if (!entry) {
	throw new Error(
		'The conformance collection has no "report" entry. docs/conformance.json is ' +
			'generated by `make conformance`; regenerate it and rebuild.',
	);
}
const report = entry.data;
const { counts, domains, checks, panels } = report;

/**
 * How much of its published tolerance a check consumes, as a fraction of one.
 *
 * The figure the Markdown report could not show. Undefined where the question
 * has no answer: a check with no declared tolerance, or a mask whose band is
 * one-sided, has nothing to be a fraction of.
 *
 * Never used to decide a verdict. The stored verdict was decided at full
 * precision before anything was rounded, and a deviation one quantum below its
 * limit rounds onto it, so recomputing the judgement here would flip a verdict
 * the harness got right.
 */
function utilisation(check: (typeof checks)[number]): number | undefined {
	const deviation = check.deviation.value;
	const tolerance = check.tolerance;
	if (deviation === undefined || tolerance === undefined) return undefined;
	if (tolerance.mode === 'mask') {
		const { lower, upper } = check.binding ?? {};
		if (lower === undefined || upper === undefined) return undefined;
		const half = (upper - lower) / 2;
		return half > 0 ? Math.abs(deviation - (upper + lower) / 2) / half : undefined;
	}
	const limit =
		tolerance.mode === 'relative'
			? (tolerance.value ?? 0) * Math.abs(check.expected.value ?? 0)
			: (tolerance.value ?? 0);
	if (limit > 0) return Math.abs(deviation) / limit;
	// A limit of zero is an exact-match check: it is either spent or it is not.
	return deviation === 0 ? 0 : 1;
}

/**
 * A number as this page prints it.
 *
 * DECISION NOT TAKEN, deliberately: the Spanish page prints the same decimal
 * point as the English one. The registry's rule is that a decimal separator
 * follows the source it is quoted from, which settles the `expected` column -
 * it is read off a printed table - and leaves the computed column arguing the
 * other way, since that number is the library's own. Localising one and not the
 * other would put both separators in one row. Switching the whole page to a
 * comma is a one-line change here (`toLocaleString(lang)`) and is the
 * maintainer's call, not this component's.
 */
function decimal(value: number, places: number) {
	const text = value
		.toFixed(Math.max(places, 0))
		.replace(/(\.\d*?)0+$/, '$1')
		.replace(/\.$/, '');
	// A value below its own display precision prints as a row of zeros, which
	// beside a utilisation of 97 % reads as a contradiction rather than as a
	// very small number. Three significant digits is the same fallback the
	// artefact writer uses when it stores one.
	return (text === '0' || text === '-0') && value !== 0 ? value.toPrecision(3) : text;
}

/** A percentage with its floating-point tail trimmed: 0.0001 is 0.01 %, not 0.010000000000000002 %. */
const percentOf = (fraction: number) => `${Number((fraction * 100).toPrecision(6))}`;

/** A value with its unit, or the label the check chose to print instead. */
function sideText(side: { value?: number; label?: string; record?: Record<string, number> }, check: (typeof checks)[number]) {
	if (side.label !== undefined) return side.label;
	if (side.record !== undefined) {
		return Object.entries(side.record)
			.map(([name, value]) => `${name} = ${decimal(value, 4)}`)
			.join('; ');
	}
	if (side.value === undefined) return '-';
	return `${decimal(side.value, check.precision)}${check.unit ? ` ${check.unit}` : ''}`;
}

/** The published limit, spelled out, or a dash where the check declares none. */
function limitText(check: (typeof checks)[number]) {
	const tolerance = check.tolerance;
	if (tolerance === undefined) return '-';
	if (tolerance.mode === 'relative') return `±${percentOf(tolerance.value ?? 0)}%`;
	if (tolerance.mode === 'mask') {
		const { lower, upper } = check.binding ?? {};
		if (lower === undefined && upper === undefined) return 'mask';
		const unit = check.unit ? ` ${check.unit}` : '';
		return `[${lower ?? '-∞'}, ${upper ?? '+∞'}]${unit}`;
	}
	const unit = check.unit ? ` ${check.unit}` : '';
	return `±${decimal(tolerance.value ?? 0, check.precision)}${unit}`;
}

/**
 * The signed deviation.
 *
 * A check that declares no tolerance has not been converted to data yet, and
 * its deviation survives only as the string it was formatted as. Printing that
 * string is what keeps this column identical to the Markdown mirror's, which
 * applies the same rule.
 */
function deviationText(check: (typeof checks)[number]) {
	if (check.tolerance === undefined || check.deviation.value === undefined) {
		return check.deviation.label ?? '-';
	}
	const unit = check.unit ? ` ${check.unit}` : '';
	return `${decimal(check.deviation.value, Math.max(check.precision, 3))}${unit}`;
}

/**
 * A margin with its sign shown, as the showcase tables print it: the sign is
 * the whole meaning of a margin, and a bare "0.40" does not say which side of
 * the limit it falls on.
 */
const signed = (value: number, places: number) =>
	`${value >= 0 ? '+' : ''}${value.toFixed(places)}`;

/** An anchor a review comment can link to. Ids carry slashes; hrefs may not. */
const anchorOf = (id: string) => id.replaceAll('/', '--');

const rows = checks.map((check) => ({
	check,
	used: utilisation(check),
	anchor: anchorOf(check.id),
}));

const byDomain = new Map<string, typeof rows>();
for (const row of rows) {
	const bucket = byDomain.get(row.check.domain) ?? [];
	bucket.push(row);
	byDomain.set(row.check.domain, bucket);
}

/** The ten checks sitting closest to their published limit. */
const closest = rows
	.filter((row) => row.used !== undefined)
	.sort((a, b) => (b.used ?? 0) - (a.used ?? 0))
	.slice(0, 10);

const percent = (used: number | undefined) =>
	used === undefined ? '-' : `${(used * 100).toFixed(used < 0.1 ? 1 : 0)} %`;

const filterPanel = panels.find((panel) => panel.id === 'filter-class');
const weightingPanel = panels.find((panel) => panel.id === 'weighting-deviation');

const t =
	lang === 'es'
		? {
				summary: (p: number, n: number, d: number, s: number) =>
					`${p} de ${n} comprobaciones superan su norma, en ${d} dominios y ${s} normas.`,
				closest: 'Las diez comprobaciones más cerca de su límite publicado',
				closestNote:
					'Fracción de la tolerancia publicada que consume cada comprobación. Un valor alto no es un fallo: es el margen con el que se cumple.',
				search: 'Buscar norma, magnitud o apartado',
				allDomains: 'Todos los dominios',
				onlyFailing: 'Solo las que no cumplen',
				standard: 'Norma',
				quantity: 'Magnitud',
				expected: 'Esperado (norma)',
				computed: 'Calculado',
				limit: 'Límite',
				deviation: 'Desviación',
				used: 'Consumido',
				status: 'Estado',
				pass: 'Cumple',
				fail: 'No cumple',
				noMatches: 'Ninguna comprobación coincide con el filtro.',
				architecture: 'Arquitectura',
				verdict: 'Veredicto',
				bindingBand: 'Banda determinante',
				measured: 'Aten. rel. medida',
				class1Limit: 'Límite clase 1',
				margin1: 'Margen cl.1',
				margin2: 'Margen cl.2',
				curve: 'Curva',
				worst: 'Desv. máx. (informativa)',
				bindingFreq: 'Frec. determinante',
				deviationThere: 'Desviación allí',
				band: 'Banda de tolerancia',
				headroom: 'Margen',
			}
		: {
				summary: (p: number, n: number, d: number, s: number) =>
					`${p} of ${n} checks meet their standard, across ${d} domains and ${s} standards.`,
				closest: 'The ten checks closest to their published limit',
				closestNote:
					'The fraction of its published tolerance each check consumes. A high figure is not a failure: it is the room the check passes with.',
				search: 'Search standard, quantity or clause',
				allDomains: 'All domains',
				onlyFailing: 'Failing rows only',
				standard: 'Standard',
				quantity: 'Quantity',
				expected: 'Expected (norm)',
				computed: 'Computed',
				limit: 'Limit',
				deviation: 'Deviation',
				used: 'Used',
				status: 'Status',
				pass: 'Pass',
				fail: 'Fail',
				noMatches: 'No check matches the filter.',
				architecture: 'Architecture',
				verdict: 'Class verdict',
				bindingBand: 'Binding band',
				measured: 'Measured rel. atten.',
				class1Limit: 'Class-1 limit',
				margin1: 'Margin cl.1',
				margin2: 'Margin cl.2',
				curve: 'Curve',
				worst: 'Max dev. from nominal (info)',
				bindingFreq: 'Binding freq',
				deviationThere: 'Deviation there',
				band: 'Tolerance band',
				headroom: 'Headroom',
			};

/** Everything one row can be searched by, lowercased once at build time. */
const searchable = (row: (typeof rows)[number]) =>
	[
		row.check.reference.cite,
		row.check.reference.designation,
		row.check.quantity,
		row.check.unit ?? '',
	]
		.join(' ')
		.toLowerCase();
---

<div class="conformance" data-conformance>
	<p class="conformance-summary">
		{t.summary(counts.passing, counts.checks, counts.domains, counts.standards)}
	</p>

	<section class="conformance-closest">
		<h2 id="closest-to-limit">{t.closest}</h2>
		<p class="note">{t.closestNote}</p>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>{t.standard}</th>
						<th>{t.quantity}</th>
						<th>{t.deviation}</th>
						<th>{t.limit}</th>
						<th>{t.used}</th>
					</tr>
				</thead>
				<tbody>
					{closest.map((row) => (
						<tr>
							<td><a href={`#${row.anchor}`}>{row.check.reference.cite}</a></td>
							<td>{row.check.quantity}</td>
							<td class="numeric">{deviationText(row.check)}</td>
							<td class="numeric">{limitText(row.check)}</td>
							<td class="numeric used">{percent(row.used)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	{filterPanel && (
		<section class="conformance-panel">
			<h2 id="filter-class">{filterPanel.title}</h2>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>{t.architecture}</th>
							<th>{t.verdict}</th>
							<th>{t.bindingBand}</th>
							<th>{t.measured}</th>
							<th>{t.class1Limit}</th>
							<th>{t.margin1}</th>
							<th>{t.margin2}</th>
						</tr>
					</thead>
					<tbody>
						{filterPanel.rows.map((row: Record<string, any>) => (
							<tr>
								<td>{row.architecture}</td>
								<td>
									{row.verdict === 'by-design'
										? `By design (${row.reason})`
										: row.class === undefined
											? 'not compliant'
											: `Class ${row.class}`}
								</td>
								<td class="numeric">{row.binding.frequency_hz} Hz</td>
								<td class="numeric">{signed(row.binding.measured, 2)} dB</td>
								<td class="numeric">
									{row.binding.side === 'ceil' ? '≤' : '≥'} {signed(row.binding.limit, 2)} dB
								</td>
								<td class="numeric">{signed(row.margin_class1, 3)} dB</td>
								<td class="numeric">{signed(row.margin_class2, 3)} dB</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	{weightingPanel && (
		<section class="conformance-panel">
			<h2 id="weighting-deviation">{weightingPanel.title}</h2>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>{t.curve}</th>
							<th>fs</th>
							<th>{t.worst}</th>
							<th>{t.bindingFreq}</th>
							<th>{t.deviationThere}</th>
							<th>{t.band}</th>
							<th>{t.headroom}</th>
						</tr>
					</thead>
					<tbody>
						{weightingPanel.rows.map((row: Record<string, any>) => (
							<tr>
								<td>{row.curve}</td>
								<td class="numeric">{row.fs_hz / 1000} kHz</td>
								<td class="numeric">
									{signed(row.worst.deviation, 3)} dB @ {row.worst.frequency_hz} Hz
								</td>
								<td class="numeric">{row.binding.frequency_hz} Hz</td>
								<td class="numeric">{signed(row.binding.deviation, 3)} dB</td>
								<td class="numeric">
									[{signed(row.binding.lower, 2)}, {signed(row.binding.upper, 2)}] dB
								</td>
								<td class="numeric">{signed(row.headroom, 3)} dB</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	<div class="conformance-controls" data-controls hidden>
		<label class="control-search">
			<span class="visually-hidden">{t.search}</span>
			<input type="search" data-search placeholder={t.search} autocomplete="off" />
		</label>
		<label class="control-domain">
			<span class="visually-hidden">{t.allDomains}</span>
			<select data-domain>
				<option value="">{t.allDomains}</option>
				{domains.map((domain) => (
					<option value={domain.id}>{domain.title}</option>
				))}
			</select>
		</label>
		<label class="control-failing">
			<input type="checkbox" data-failing />
			{t.onlyFailing}
		</label>
	</div>
	<p class="conformance-empty" data-empty hidden>{t.noMatches}</p>

	{domains.map((domain) => {
		const domainRows = byDomain.get(domain.id) ?? [];
		const green = domain.passing === domain.checks;
		return (
			<details class="conformance-domain" data-domain-section={domain.id} open={!green}>
				<summary>
					<span class={green ? 'mark pass' : 'mark fail'} aria-hidden="true">
						{green ? '✓' : '✗'}
					</span>
					<b>{domain.title}</b>
					<span class="tally">
						{domain.passing}/{domain.checks}
					</span>
				</summary>
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th>{t.standard}</th>
								<th>{t.quantity}</th>
								<th>{t.expected}</th>
								<th>{t.computed}</th>
								<th>{t.limit}</th>
								<th>{t.deviation}</th>
								<th>{t.used}</th>
								<th>{t.status}</th>
							</tr>
						</thead>
						<tbody>
							{domainRows.map((row) => (
								<tr
									id={row.anchor}
									data-row
									data-verdict={row.check.verdict}
									data-text={searchable(row)}
								>
									<td>
										<span class="designation">{row.check.reference.designation}</span>
										{row.check.reference.edition && (
											<span class="edition">{row.check.reference.edition}</span>
										)}
										{row.check.reference.clause && (
											<span class="clause">{row.check.reference.clause}</span>
										)}
									</td>
									<td>{row.check.quantity}</td>
									<td>{sideText(row.check.expected, row.check)}</td>
									<td>{sideText(row.check.computed, row.check)}</td>
									<td class="numeric">{limitText(row.check)}</td>
									<td class="numeric">{deviationText(row.check)}</td>
									<td class="numeric used">{percent(row.used)}</td>
									<td class="status">
										<span class={row.check.verdict === 'pass' ? 'mark pass' : 'mark fail'}>
											{row.check.verdict === 'pass' ? '✓' : '✗'}
										</span>
										<span class="visually-hidden">
											{row.check.verdict === 'pass' ? t.pass : t.fail}
										</span>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</details>
		);
	})}
</div>

<script>
	// Progressive enhancement only: every row is already in the document, so a
	// reader without JavaScript, and Pagefind's crawler, both see the whole
	// report. The controls are hidden until this runs, so nothing offers a
	// filter that would not work.
	const root = document.querySelector('[data-conformance]');
	if (root) {
		const controls = root.querySelector('[data-controls]') as HTMLElement | null;
		const search = root.querySelector('[data-search]') as HTMLInputElement | null;
		const domain = root.querySelector('[data-domain]') as HTMLSelectElement | null;
		const failing = root.querySelector('[data-failing]') as HTMLInputElement | null;
		const empty = root.querySelector('[data-empty]') as HTMLElement | null;
		const sections = [...root.querySelectorAll('[data-domain-section]')] as HTMLDetailsElement[];
		const rows = [...root.querySelectorAll('[data-row]')] as HTMLElement[];
		controls?.removeAttribute('hidden');

		const apply = () => {
			const needle = (search?.value ?? '').trim().toLowerCase();
			const wanted = domain?.value ?? '';
			const onlyFailing = failing?.checked ?? false;
			let shown = 0;
			for (const row of rows) {
				const text = row.dataset.text ?? '';
				const visible =
					(!needle || text.includes(needle)) &&
					(!onlyFailing || row.dataset.verdict !== 'pass');
				row.hidden = !visible;
				if (visible) shown += 1;
			}
			for (const section of sections) {
				const id = section.dataset.domainSection ?? '';
				const inDomain = !wanted || wanted === id;
				const visibleRows = [...section.querySelectorAll('[data-row]')].filter(
					(row) => !(row as HTMLElement).hidden,
				).length;
				section.hidden = !inDomain || visibleRows === 0;
				// A filter is a question, so open what answers it; with no filter
				// on, fall back to the report's own rule of opening only what fails.
				if (!section.hidden && (needle || onlyFailing || wanted)) section.open = true;
			}
			const anyVisible = sections.some((section) => !section.hidden);
			if (empty) empty.hidden = anyVisible;
			// Keep the count honest for a screen reader reading the controls.
			controls?.setAttribute('data-shown', String(shown));
		};

		search?.addEventListener('input', apply);
		domain?.addEventListener('change', apply);
		failing?.addEventListener('change', apply);

		// A link to one row has to open the section holding it, or the browser
		// scrolls to an element inside a closed <details> and lands nowhere.
		const reveal = () => {
			const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
			const section = target?.closest('details');
			if (section) {
				section.open = true;
				target?.scrollIntoView({ block: 'center' });
			}
		};
		window.addEventListener('hashchange', reveal);
		reveal();
	}
</script>

<style>
	.conformance-summary {
		font-size: var(--sl-text-lg);
		margin-block: 0.5rem 1.5rem;
	}

	.conformance .note {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-block: 0.25rem 0.75rem;
	}

	/* Wide tables scroll inside their own box; the page body never does. */
	.table-scroll {
		overflow-x: auto;
		margin-block: 0.5rem 1rem;
	}

	.conformance table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}

	.conformance th,
	.conformance td {
		border-bottom: 1px solid var(--sl-color-gray-5);
		padding: 0.35rem 0.6rem;
		text-align: start;
		vertical-align: top;
	}

	.conformance td.numeric {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		text-align: end;
	}

	.conformance td.used {
		font-weight: 600;
	}

	/* The designation leads, the edition and clause follow it as metadata: the
	   citation string used to be one run of text in which the document and the
	   place inside it were indistinguishable. */
	.conformance .designation {
		font-weight: 600;
	}

	.conformance .edition::before {
		content: ':';
	}

	.conformance .clause {
		display: block;
		color: var(--sl-color-gray-3);
	}

	.conformance .mark {
		font-weight: 700;
	}

	.conformance .mark.pass {
		color: var(--sl-color-green-high, green);
	}

	.conformance .mark.fail {
		color: var(--sl-color-red-high, red);
	}

	.conformance td.status {
		text-align: center;
	}

	.conformance-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
		margin-block: 1.5rem 1rem;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	.conformance-controls input[type='search'],
	.conformance-controls select {
		font: inherit;
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.3rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
	}

	.control-search {
		flex: 1 1 16rem;
	}

	.control-search input {
		width: 100%;
	}

	.control-failing {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--sl-text-sm);
	}

	.conformance-domain {
		border-top: 1px solid var(--sl-color-gray-5);
		padding-block: 0.4rem;
	}

	.conformance-domain summary {
		cursor: pointer;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: var(--sl-text-base);
	}

	.conformance-domain .tally {
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
		font-size: var(--sl-text-sm);
	}

	/* The anchor target gets a moment of colour, so a reader who followed a
	   link to one check can see which row answered. */
	.conformance tr:target td {
